##Opg 5.1 Månedlige observationer

klasse <- rep(c("A", "B", "C", "D"), each = 9)

uge <- rep(1:9, times = 4)

score <- rep(c(6, 12, 18, 24, 30, 36), times = 6)

df.mdr_obs <- data.frame(Klasse, uge, Score)


##Opg 5.2 Kvartalvise observationer
total <- 0 # Sætter værdi til 0
result <- data.frame() # Laver en tom data-frame

for (i in 1:nrow(df.mdr_obs)) {
  total <- total + df.mdr_obs[i, 3]
  if (i %% 3 == 0) { #Kontrollerer hvis du kan trække 3 fra i, om den giver 0, hvis ja, fortsæt!
    result <- rbind(result, data.frame(df.mdr_obs[i, 1], df.mdr_obs[i, 2], total/3))
    total <- 0
  }
}

result <- result %>%
  rename(
    Klasse = df.mdr_obs.i...1.,
    Uge = df.mdr_obs.i...2.,
    Score = total.3
  ) # Rename af kolonner

## i = 1, er 1 = 0, nej, derfor hopper vi ikke ind i if-statement i modulo.
## derfor vil værdien altså 1 fra forrige loop følge med til start loop.
## når vi så når til 3 vil den opfylde if-statement, så ved rbind når kravet er opfyldt
## vil vi så smide det ind i dataframen. Her tager vi værdien af de tre rækkers værdier,
## dividerer dem med 3 for at finde gns. af de 3 første rækker osv. vel og mærke kun
## sidste kolonne

