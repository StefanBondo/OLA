##Opgave 3.2 -----------------------------------------------------------
library(DBI)
library(dplyr)
library(glue)
library(stringr)

# ------------------------------------------------------------
# PARAMETRE
# ------------------------------------------------------------
comp_id   <- 328
date_from <- as.Date("2024-07-01")
date_to   <- Sys.Date()

date_from_sql <- format(date_from, "%Y-%m-%d")
date_to_sql   <- format(date_to, "%Y-%m-%d")

min_passes <- 200     # du kan sænke til fx 100 hvis få spillere
min_shots  <- 10      # shot volume threshold
k <- 4
set.seed(123)

# ------------------------------------------------------------
# 1) PASSES (common driver) + dedupe pass-details
# ------------------------------------------------------------
query_passes <- glue::glue("
  SELECT
    c.EVENT_WYID,
    c.MATCH_WYID,
    c.TEAM_WYID,
    c.PLAYER_WYID,
    m.DATE AS match_date,
    p.ACCURATE,
    p.LENGTH,
    p.ANGLE,
    p.HEIGHT
  FROM wyscout_matchevents_common c
  JOIN wyscout_matches m
    ON c.MATCH_WYID = m.MATCH_WYID
  LEFT JOIN (
    SELECT
      EVENT_WYID,
      MAX(ACCURATE) AS ACCURATE,
      MAX(LENGTH)   AS LENGTH,
      MAX(ANGLE)    AS ANGLE,
      MAX(HEIGHT)   AS HEIGHT
    FROM wyscout_matchevents_passes
    GROUP BY EVENT_WYID
  ) p
    ON c.EVENT_WYID = p.EVENT_WYID
  WHERE m.COMPETITION_WYID = {comp_id}
    AND c.PRIMARYTYPE = 'pass'
    AND m.DATE >= '{date_from_sql}'
    AND m.DATE <= '{date_to_sql}'
")

passes_raw <- dbGetQuery(con, query_passes) %>%
  mutate(
    LENGTH = as.numeric(LENGTH),
    ANGLE  = as.numeric(ANGLE),
    ACCURATE_NUM = case_when(
      ACCURATE %in% c(1, "1", TRUE, "TRUE", "true", "t", "T") ~ 1,
      ACCURATE %in% c(0, "0", FALSE, "FALSE", "false", "f", "F") ~ 0,
      TRUE ~ NA_real_
    )
  ) %>%
  distinct(EVENT_WYID, .keep_all = TRUE)

passes_player <- passes_raw %>%
  filter(!is.na(PLAYER_WYID)) %>%
  group_by(PLAYER_WYID, TEAM_WYID) %>%
  summarise(
    n_passes = n(),
    
    n_len_known = sum(!is.na(LENGTH)),
    avg_pass_length = ifelse(n_len_known == 0, NA_real_, mean(LENGTH, na.rm = TRUE)),
    sd_pass_length  = ifelse(n_len_known < 2, NA_real_, sd(LENGTH, na.rm = TRUE)),
    long_pass_ratio = ifelse(n_len_known == 0, NA_real_, mean(LENGTH >= 30, na.rm = TRUE)),
    
    n_acc_known = sum(!is.na(ACCURATE_NUM)),
    pass_accuracy = ifelse(n_acc_known == 0, NA_real_, mean(ACCURATE_NUM, na.rm = TRUE)),
    
    n_ang_known = sum(!is.na(ANGLE)),
    avg_pass_abs_angle = ifelse(n_ang_known == 0, NA_real_, mean(abs(ANGLE), na.rm = TRUE)),
    
    n_height_known = sum(!is.na(HEIGHT)),
    high_pass_ratio = ifelse(n_height_known == 0, NA_real_, mean(tolower(HEIGHT) == "high", na.rm = TRUE)),
    
    .groups = "drop"
  ) %>%
  filter(n_passes >= min_passes)

cat("Players with passes >= ", min_passes, ": ", nrow(passes_player), "\n", sep="")

# ------------------------------------------------------------
# 2) SHOTS (common driver) + secondarytypes
# ------------------------------------------------------------
query_shots <- glue::glue("
  SELECT
    c.EVENT_WYID,
    c.MATCH_WYID,
    c.TEAM_WYID,
    c.PLAYER_WYID,
    c.LOCATIONX,
    c.LOCATIONY,
    c.MINUTE,
    st.SECONDARYTYPE1,
    st.SECONDARYTYPE2,
    st.SECONDARYTYPE3,
    st.SECONDARYTYPE4,
    st.SECONDARYTYPE5,
    st.SECONDARYTYPE6,
    st.SECONDARYTYPE7
  FROM wyscout_matchevents_common c
  JOIN wyscout_matches m
    ON c.MATCH_WYID = m.MATCH_WYID
  LEFT JOIN wyscout_matchevents_secondarytype st
    ON c.EVENT_WYID = st.EVENT_WYID
  WHERE m.COMPETITION_WYID = {comp_id}
    AND c.PRIMARYTYPE = 'shot'
    AND m.DATE >= '{date_from_sql}'
    AND m.DATE <= '{date_to_sql}'
")

shots_raw <- dbGetQuery(con, query_shots) %>%
  mutate(
    LOCATIONX = as.numeric(LOCATIONX),
    LOCATIONY = as.numeric(LOCATIONY),
    MINUTE = as.numeric(MINUTE),
    sec_all = str_to_lower(paste(
      SECONDARYTYPE1, SECONDARYTYPE2, SECONDARYTYPE3, SECONDARYTYPE4,
      SECONDARYTYPE5, SECONDARYTYPE6, SECONDARYTYPE7,
      sep = " | "
    ))
  ) %>%
  distinct(EVENT_WYID, .keep_all = TRUE)

# simple shot geometry (samme som din xG-skitse)
goal_x <- 100
goal_y <- 50

shots_feat <- shots_raw %>%
  filter(!is.na(LOCATIONX), !is.na(LOCATIONY)) %>%
  mutate(
    dx = goal_x - LOCATIONX,
    dy = abs(goal_y - LOCATIONY),
    shot_distance = sqrt(dx^2 + dy^2),
    shot_angle_deg = atan2(dy, dx) * 180 / pi,
    is_goal = ifelse(str_detect(sec_all, "\\bgoal\\b"), 1L, 0L),
    is_head = ifelse(str_detect(sec_all, "\\bhead_shot\\b"), 1L, 0L),
    touch_in_box = ifelse(str_detect(sec_all, "\\btouch_in_box\\b"), 1L, 0L),
    opportunity = ifelse(str_detect(sec_all, "\\bopportunity\\b"), 1L, 0L)
  ) %>%
  filter(dx > 0)

shots_player <- shots_feat %>%
  filter(!is.na(PLAYER_WYID)) %>%
  group_by(PLAYER_WYID, TEAM_WYID) %>%
  summarise(
    n_shots = n(),
    goals = sum(is_goal, na.rm = TRUE),
    goal_rate = ifelse(n_shots == 0, NA_real_, goals / n_shots),
    
    avg_shot_distance = mean(shot_distance, na.rm = TRUE),
    sd_shot_distance  = sd(shot_distance, na.rm = TRUE),
    avg_shot_angle    = mean(shot_angle_deg, na.rm = TRUE),
    
    head_shot_ratio = mean(is_head == 1, na.rm = TRUE),
    touch_in_box_ratio = mean(touch_in_box == 1, na.rm = TRUE),
    opportunity_ratio = mean(opportunity == 1, na.rm = TRUE),
    
    .groups = "drop"
  ) %>%
  filter(n_shots >= min_shots)

cat("Players with shots >= ", min_shots, ": ", nrow(shots_player), "\n", sep="")

# ------------------------------------------------------------
# 3) Navne (spillere/hold) + merge passes + shots
# ------------------------------------------------------------
players <- dbGetQuery(con, "
  SELECT
    PLAYER_WYID,
    CONCAT(FIRSTNAME, ' ', LASTNAME) AS player_name
  FROM wyscout_players
") %>% distinct(PLAYER_WYID, .keep_all = TRUE)

teams <- dbGetQuery(con, "
  SELECT TEAM_WYID, TEAMNAME AS team_name
  FROM wyscout_teams
") %>% distinct(TEAM_WYID, .keep_all = TRUE)

# merge: behold spillere som har passes (du kan også bruge full_join hvis du vil have alle)
player_profile <- passes_player %>%
  inner_join(shots_player, by = c("PLAYER_WYID", "TEAM_WYID")) %>%
  left_join(players, by = "PLAYER_WYID") %>%
  left_join(teams, by = "TEAM_WYID")

cat("Players with BOTH passes+shots (for clustering):", nrow(player_profile), "\n")

# ------------------------------------------------------------
# 4) Clustering features + rens + drop 0-varians + kmeans
# ------------------------------------------------------------
cluster_features <- player_profile %>%
  select(
    # passes
    n_passes, pass_accuracy, avg_pass_length, sd_pass_length, long_pass_ratio,
    avg_pass_abs_angle, high_pass_ratio,
    
    # shots
    n_shots, goals, goal_rate,
    avg_shot_distance, sd_shot_distance, avg_shot_angle,
    head_shot_ratio, touch_in_box_ratio, opportunity_ratio
  ) %>%
  mutate(across(everything(), ~ ifelse(is.nan(.), NA, .)))

# drop rækker med NA/Inf (alternativt kan man imputere)
keep_rows <- complete.cases(cluster_features) & apply(cluster_features, 1, function(r) all(is.finite(r)))
player_profile_clean <- player_profile[keep_rows, ]
cluster_features_clean <- cluster_features[keep_rows, ]

cat("Players after cleaning:", nrow(player_profile_clean), "\n")

# drop 0-varians kolonner (for at undgå scale->NaN)
sds <- apply(cluster_features_clean, 2, sd, na.rm = TRUE)
keep_cols <- is.finite(sds) & (sds > 0)
dropped <- names(sds)[!keep_cols]
if (length(dropped) > 0) cat("Dropped zero-variance cols:", paste(dropped, collapse = ", "), "\n")

cluster_features_clean <- cluster_features_clean[, keep_cols, drop = FALSE]

X <- scale(cluster_features_clean)
stopifnot(all(is.finite(X)))

set.seed(123)
km <- kmeans(X, centers = k, nstart = 50)

player_profile_clean$cluster <- factor(km$cluster)

# ------------------------------------------------------------
# 5) Output: cluster-profiler + spillere pr. cluster
# ------------------------------------------------------------
cluster_summary <- player_profile_clean %>%
  group_by(cluster) %>%
  summarise(
    players = n(),
    n_passes = mean(n_passes),
    pass_accuracy = mean(pass_accuracy, na.rm = TRUE),
    avg_pass_length = mean(avg_pass_length, na.rm = TRUE),
    long_pass_ratio = mean(long_pass_ratio, na.rm = TRUE),
    
    n_shots = mean(n_shots),
    goals = mean(goals),
    goal_rate = mean(goal_rate, na.rm = TRUE),
    avg_shot_distance = mean(avg_shot_distance, na.rm = TRUE),
    touch_in_box_ratio = mean(touch_in_box_ratio, na.rm = TRUE),
    head_shot_ratio = mean(head_shot_ratio, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  arrange(cluster)

print(cluster_summary)

# Eksempel: top 10 spillere pr cluster (volumen)
top_players <- player_profile_clean %>%
  arrange(cluster, desc(n_passes)) %>%
  select(cluster, player_name, team_name, n_passes, pass_accuracy, avg_pass_length,
         n_shots, goals, goal_rate, avg_shot_distance) %>%
  group_by(cluster) %>%
  slice_head(n = 10) %>%
  ungroup()

print(top_players)

# Gem gerne til videre brug
res_32 <- list(players = player_profile_clean, summary = cluster_summary, model = km)

#Opgave 3.3 --------------------------------------------------------------------------
#Model 3.1 Clustering på baggrund af afleveringsdata viser, at spillerne i 1. division kan opdeles i flere typer data baseret på volume, længde af afleveringer, lange/høje afleveringer og vinkelprofil.
# Vi kan f.eks se at midtbanespillere har en høj afleveringsvolume, mellem til kort gennemsnitslængde på afleveringer og en lavere andel lange bolde.
#Model 3.2 når vi kombinerer skud/afleveringsdata får vi en mere fortolkbar segmentering. f.eks har vi følgende:
# Spillere med lavere afleveringsvolume men høj skudrate er angribere eller kantspillere
# Spillere med høj aflevering og skudvolume spiller typisk midtbane/central offensiv
# Spillere med høj andel skud  feltet (Touch_in_box) er boksspillere
# Så modellen afslører altså mere eller mindre hvilke spillertyper vi har at gøre med, uden nødvendigvis at have den baggrundsviden.

#Man kunne eventuelt have lavet clustering inden for positioner, for at få et mere meningsfuldt segment. Ved at gøre dette ville det være nemmere at holde spillere op mod hinanden, da der er en væsentlig forskel i deres resultatater alt afhængig af deres position på banen.

#Opgave 3.4
library(DBI)
library(dplyr)
library(glue)
library(stringr)
library(tidyr)
con <- dbConnect(
  MariaDB(),
  host = "www.talmedos.com",
  port = 3306,
  db = "superliga2",
  user = "dalremote",
  password = "OttoRehagel123456789Long2026!"
)
stopifnot(exists("con"))

# =========================================================
# PARAMETRE
# =========================================================
COMP_SUPERLIGA <- 335
COMP_1DIV      <- 328

date_from <- as.Date("2024-07-01")
date_to   <- Sys.Date()

date_from_sql <- format(date_from, "%Y-%m-%d")
date_to_sql   <- format(date_to,   "%Y-%m-%d")

# Minimum for at tælle som "har spillet"
min_matches_1div <- 5
min_matches_sl   <- 3

# =========================================================
# 1) HENT MATCH-DELTA (hvilke spillere optræder i hvilke kampe)
#    -> vi bruger common-events til at sige "spiller var i kampen"
# =========================================================
query_player_matches <- glue::glue("
  SELECT
    m.COMPETITION_WYID,
    m.MATCH_WYID,
    m.DATE AS match_date,
    c.PLAYER_WYID,
    c.TEAM_WYID
  FROM wyscout_matches m
  JOIN wyscout_matchevents_common c
    ON m.MATCH_WYID = c.MATCH_WYID
  WHERE m.COMPETITION_WYID IN ({COMP_SUPERLIGA}, {COMP_1DIV})
    AND m.DATE >= '{date_from_sql}'
    AND m.DATE <= '{date_to_sql}'
    AND c.PLAYER_WYID IS NOT NULL
")

player_matches <- dbGetQuery(con, query_player_matches) %>%
  mutate(match_date = as.Date(match_date)) %>%
  distinct(COMPETITION_WYID, MATCH_WYID, PLAYER_WYID, .keep_all = TRUE)

# pr spiller pr liga: antal kampe + første kampdato
player_comp_summary <- player_matches %>%
  group_by(COMPETITION_WYID, PLAYER_WYID) %>%
  summarise(
    matches = n_distinct(MATCH_WYID),
    first_date = min(match_date, na.rm = TRUE),
    last_date  = max(match_date, na.rm = TRUE),
    .groups = "drop"
  )

# split superliga og 1.div
p1 <- player_comp_summary %>%
  filter(COMPETITION_WYID == COMP_1DIV) %>%
  transmute(
    PLAYER_WYID,
    matches_1div = matches,
    first_1div   = first_date,
    last_1div    = last_date
  )

psl <- player_comp_summary %>%
  filter(COMPETITION_WYID == COMP_SUPERLIGA) %>%
  transmute(
    PLAYER_WYID,
    matches_sl = matches,
    first_sl   = first_date,
    last_sl    = last_date
  )

# Movers: har 1.div først og senere superliga + minimumskrav til kampe
movers <- p1 %>%
  inner_join(psl, by = "PLAYER_WYID") %>%
  filter(
    matches_1div >= min_matches_1div,
    matches_sl   >= min_matches_sl,
    first_sl > first_1div
  )

cat("Antal spillere der går fra 1.div -> Superliga (i perioden):", nrow(movers), "\n")

# =========================================================
# 2) HENT NAVNE (spillere/hold)
# =========================================================
players <- dbGetQuery(con, "
  SELECT
    PLAYER_WYID,
    CONCAT(FIRSTNAME, ' ', LASTNAME) AS player_name
  FROM wyscout_players
") %>% distinct(PLAYER_WYID, .keep_all = TRUE)

teams <- dbGetQuery(con, "
  SELECT TEAM_WYID, TEAMNAME AS team_name
  FROM wyscout_teams
") %>% distinct(TEAM_WYID, .keep_all = TRUE)

# =========================================================
# 3) FUNKTIONER: PASS-PROFIL og SHOT-PROFIL pr spiller pr liga
#    (normaliseret pr kamp: per_match = total / matches)
# =========================================================
get_pass_profile <- function(comp_id) {
  q <- glue::glue("
    SELECT
      c.EVENT_WYID,
      c.MATCH_WYID,
      c.TEAM_WYID,
      c.PLAYER_WYID,
      m.DATE AS match_date,
      p.ACCURATE,
      p.LENGTH,
      p.ANGLE,
      p.HEIGHT
    FROM wyscout_matchevents_common c
    JOIN wyscout_matches m
      ON c.MATCH_WYID = m.MATCH_WYID
    LEFT JOIN (
      SELECT
        EVENT_WYID,
        MAX(ACCURATE) AS ACCURATE,
        MAX(LENGTH)   AS LENGTH,
        MAX(ANGLE)    AS ANGLE,
        MAX(HEIGHT)   AS HEIGHT
      FROM wyscout_matchevents_passes
      GROUP BY EVENT_WYID
    ) p
      ON c.EVENT_WYID = p.EVENT_WYID
    WHERE m.COMPETITION_WYID = {comp_id}
      AND c.PRIMARYTYPE = 'pass'
      AND m.DATE >= '{date_from_sql}'
      AND m.DATE <= '{date_to_sql}'
  ")
  
  raw <- dbGetQuery(con, q) %>%
    mutate(
      LENGTH = as.numeric(LENGTH),
      ANGLE  = as.numeric(ANGLE),
      ACCURATE_NUM = case_when(
        ACCURATE %in% c(1, "1", TRUE, "TRUE", "true", "t", "T") ~ 1,
        ACCURATE %in% c(0, "0", FALSE, "FALSE", "false", "f", "F") ~ 0,
        TRUE ~ NA_real_
      )
    ) %>%
    distinct(EVENT_WYID, .keep_all = TRUE)
  
  # matches pr spiller i liga (fra player_matches)
  matches_tbl <- player_matches %>%
    filter(COMPETITION_WYID == comp_id) %>%
    group_by(PLAYER_WYID) %>%
    summarise(matches = n_distinct(MATCH_WYID), .groups = "drop")
  
  prof <- raw %>%
    filter(!is.na(PLAYER_WYID)) %>%
    group_by(PLAYER_WYID) %>%
    summarise(
      passes = n(),
      
      n_acc_known = sum(!is.na(ACCURATE_NUM)),
      pass_accuracy = ifelse(n_acc_known == 0, NA_real_, mean(ACCURATE_NUM, na.rm = TRUE)),
      
      n_len_known = sum(!is.na(LENGTH)),
      avg_pass_length = ifelse(n_len_known == 0, NA_real_, mean(LENGTH, na.rm = TRUE)),
      long_pass_ratio = ifelse(n_len_known == 0, NA_real_, mean(LENGTH >= 30, na.rm = TRUE)),
      
      n_ang_known = sum(!is.na(ANGLE)),
      avg_pass_abs_angle = ifelse(n_ang_known == 0, NA_real_, mean(abs(ANGLE), na.rm = TRUE)),
      
      n_height_known = sum(!is.na(HEIGHT)),
      high_pass_ratio = ifelse(n_height_known == 0, NA_real_, mean(tolower(HEIGHT) == "high", na.rm = TRUE)),
      
      .groups = "drop"
    ) %>%
    left_join(matches_tbl, by = "PLAYER_WYID") %>%
    mutate(
      passes_per_match = ifelse(matches > 0, passes / matches, NA_real_),
      comp_id = comp_id
    )
  
  prof
}

get_shot_profile <- function(comp_id) {
  q <- glue::glue("
    SELECT
      c.EVENT_WYID,
      c.MATCH_WYID,
      c.TEAM_WYID,
      c.PLAYER_WYID,
      c.LOCATIONX,
      c.LOCATIONY,
      st.SECONDARYTYPE1,
      st.SECONDARYTYPE2,
      st.SECONDARYTYPE3,
      st.SECONDARYTYPE4,
      st.SECONDARYTYPE5,
      st.SECONDARYTYPE6,
      st.SECONDARYTYPE7
    FROM wyscout_matchevents_common c
    JOIN wyscout_matches m
      ON c.MATCH_WYID = m.MATCH_WYID
    LEFT JOIN wyscout_matchevents_secondarytype st
      ON c.EVENT_WYID = st.EVENT_WYID
    WHERE m.COMPETITION_WYID = {comp_id}
      AND c.PRIMARYTYPE = 'shot'
      AND m.DATE >= '{date_from_sql}'
      AND m.DATE <= '{date_to_sql}'
  ")
  
  raw <- dbGetQuery(con, q) %>%
    mutate(
      LOCATIONX = as.numeric(LOCATIONX),
      LOCATIONY = as.numeric(LOCATIONY),
      sec_all = str_to_lower(paste(
        SECONDARYTYPE1, SECONDARYTYPE2, SECONDARYTYPE3, SECONDARYTYPE4,
        SECONDARYTYPE5, SECONDARYTYPE6, SECONDARYTYPE7,
        sep = " | "
      ))
    ) %>%
    distinct(EVENT_WYID, .keep_all = TRUE)
  
  # simpel shot-geometri
  goal_x <- 100
  goal_y <- 50
  
  raw <- raw %>%
    filter(!is.na(LOCATIONX), !is.na(LOCATIONY)) %>%
    mutate(
      dx = goal_x - LOCATIONX,
      dy = abs(goal_y - LOCATIONY),
      shot_distance = sqrt(dx^2 + dy^2),
      is_goal = ifelse(str_detect(sec_all, "\\bgoal\\b"), 1L, 0L),
      is_head = ifelse(str_detect(sec_all, "\\bhead_shot\\b"), 1L, 0L),
      touch_in_box = ifelse(str_detect(sec_all, "\\btouch_in_box\\b"), 1L, 0L),
      opportunity = ifelse(str_detect(sec_all, "\\bopportunity\\b"), 1L, 0L)
    ) %>%
    filter(dx > 0)
  
  matches_tbl <- player_matches %>%
    filter(COMPETITION_WYID == comp_id) %>%
    group_by(PLAYER_WYID) %>%
    summarise(matches = n_distinct(MATCH_WYID), .groups = "drop")
  
  prof <- raw %>%
    filter(!is.na(PLAYER_WYID)) %>%
    group_by(PLAYER_WYID) %>%
    summarise(
      shots = n(),
      goals = sum(is_goal, na.rm = TRUE),
      goal_rate = ifelse(shots > 0, goals / shots, NA_real_),
      
      avg_shot_distance = mean(shot_distance, na.rm = TRUE),
      head_shot_ratio = mean(is_head == 1, na.rm = TRUE),
      touch_in_box_ratio = mean(touch_in_box == 1, na.rm = TRUE),
      opportunity_ratio = mean(opportunity == 1, na.rm = TRUE),
      
      .groups = "drop"
    ) %>%
    left_join(matches_tbl, by = "PLAYER_WYID") %>%
    mutate(
      shots_per_match = ifelse(matches > 0, shots / matches, NA_real_),
      goals_per_match = ifelse(matches > 0, goals / matches, NA_real_),
      comp_id = comp_id
    )
  
  prof
}

# =========================================================
# 4) BYG PROFILER FOR 1.DIV og SUPERLIGA
# =========================================================
passes_1div <- get_pass_profile(COMP_1DIV)
shots_1div  <- get_shot_profile(COMP_1DIV)

passes_sl <- get_pass_profile(COMP_SUPERLIGA)
shots_sl  <- get_shot_profile(COMP_SUPERLIGA)

profile_1div <- passes_1div %>%
  full_join(shots_1div, by = c("PLAYER_WYID", "comp_id")) %>%
  mutate(comp = "1.div")

profile_sl <- passes_sl %>%
  full_join(shots_sl, by = c("PLAYER_WYID", "comp_id")) %>%
  mutate(comp = "superliga")

# =========================================================
# 5) COMPARE: Superliga movers vs 1.div distribution
# =========================================================
# Baseline = alle spillere i 1.div profilen
baseline <- profile_1div

# Movers i superliga
movers_sl <- movers %>%
  select(PLAYER_WYID) %>%
  inner_join(profile_sl, by = "PLAYER_WYID") %>%
  left_join(players, by = "PLAYER_WYID")

# (valgfrit) tilføj holdnavn for deres seneste SL-hold via player_matches
last_team_sl <- player_matches %>%
  filter(COMPETITION_WYID == COMP_SUPERLIGA) %>%
  group_by(PLAYER_WYID) %>%
  summarise(TEAM_WYID = dplyr::last(TTEAM <- TEAM_WYID), .groups = "drop")

# Ovenstående "last" på TEAM_WYID kan være ustabil pga rækkefølge; brug max dato:
last_team_sl <- player_matches %>%
  filter(COMPETITION_WYID == COMP_SUPERLIGA) %>%
  group_by(PLAYER_WYID) %>%
  slice_max(match_date, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  select(PLAYER_WYID, TEAM_WYID) %>%
  distinct()

movers_sl <- movers_sl %>%
  left_join(last_team_sl, by = "PLAYER_WYID") %>%
  left_join(teams, by = "TEAM_WYID")

# Metrics vi vil sammenligne (vælg 6-10 så det er overskueligt)
metrics <- c(
  "passes_per_match",
  "pass_accuracy",
  "avg_pass_length",
  "long_pass_ratio",
  "shots_per_match",
  "goals_per_match",
  "avg_shot_distance",
  "touch_in_box_ratio"
)

# Funktion: percentile + z-score ift baseline
calc_compare <- function(df_movers, df_base, metric) {
  base <- df_base[[metric]]
  base <- base[is.finite(base)]
  mu <- mean(base, na.rm = TRUE)
  sdv <- sd(base, na.rm = TRUE)
  
  x <- df_movers[[metric]]
  z <- (x - mu) / sdv
  
  # percentile: andel baseline <= x
  pct <- sapply(x, function(v) mean(base <= v, na.rm = TRUE))
  
  tibble(
    PLAYER_WYID = df_movers$PLAYER_WYID,
    metric = metric,
    value = x,
    z_score = z,
    percentile_vs_1div = pct
  )
}

compare_long <- bind_rows(lapply(metrics, function(m) calc_compare(movers_sl, baseline, m)))

# Pivot til bredt format (pæn tabel)
compare_wide <- compare_long %>%
  mutate(
    percentile_vs_1div = round(100 * percentile_vs_1div, 1),
    z_score = round(z_score, 2),
    value = round(value, 3)
  ) %>%
  select(PLAYER_WYID, metric, value, z_score, percentile_vs_1div) %>%
  pivot_wider(
    names_from = metric,
    values_from = c(value, z_score, percentile_vs_1div)
  ) %>%
  left_join(movers_sl %>% select(PLAYER_WYID, player_name, team_name), by = "PLAYER_WYID") %>%
  relocate(player_name, team_name, PLAYER_WYID)

# “Outlier”-flag: mindst én metric i top 95% eller z > 2
outlier_flags <- compare_long %>%
  group_by(PLAYER_WYID) %>%
  summarise(
    any_top95 = any(percentile_vs_1div >= 0.95, na.rm = TRUE),
    any_z_gt2 = any(z_score >= 2, na.rm = TRUE),
    .groups = "drop"
  )

final_table <- compare_wide %>%
  left_join(outlier_flags, by = "PLAYER_WYID") %>%
  arrange(desc(any_top95), desc(any_z_gt2))

# =========================================================
# 6) OUTPUT
# =========================================================
cat("\n--- SCOUTING TABLE: Superliga spillere der kommer fra 1.div ---\n")
print(final_table)

cat("\n--- TOP OUTLIERS (har top95 eller z>2 på mindst én metric) ---\n")
print(final_table %>% filter(any_top95 | any_z_gt2) %>% head(25))

# Hvis du vil gemme til CSV:
write.csv(final_table, "scouting_1div_to_superliga.csv", row.names = FALSE)

