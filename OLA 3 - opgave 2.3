library(dplyr)

## 1) Find de X-variabler, der er brugt i pcr.fit (de 12 spørgsmål) ----
Xvars <- colnames(pcr.fit$model)[-1]   # smider Y, beholder kun X

## 2) Tag de samme variabler ud af tillid_pcr og gør dem numeriske ----
X_train <- tillid_pcr %>%
  select(all_of(Xvars)) %>%
  mutate(across(everything(), ~ as.numeric(.)))

## 3) Beregn gennemsnittet af hver af de 12 spørgsmål (gennemsnit af gennemsnittet-idé) ----
X_means <- colMeans(X_train, na.rm = TRUE)

## 4) Lav et syntetisk "kvartal", hvor hver variabel = sit historiske gennemsnit ----
newdata_pcr_mean <- as.data.frame(t(X_means))
colnames(newdata_pcr_mean) <- Xvars   # sørg for at kolonnenavne matcher pcr.fit

## 5) Forudsig realvækst med pcr.fit, ncomp = 4 ----
pred_q4_2025_pcr <- as.numeric(
  predict(pcr.fit,
          newdata = newdata_pcr_mean,
          ncomp   = 4)
)

cat(
  "Forudsagt årlig realvækst i husholdningernes forbrug",
  round(pred_q4_2025_pcr, 2), "%\n"
)
