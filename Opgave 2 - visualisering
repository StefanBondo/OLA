# --------------------------------------------------
# 10. Visualisering: xP vs faktiske point
# --------------------------------------------------
ggplot(xp_table, aes(x = samlet_xP, y = faktiske_point, label = team_name)) +
  geom_abline(slope = 1, intercept = 0, linetype = "dashed", linewidth = 0.8) +
  geom_point(size = 3.5) +
  geom_text(nudge_y = 0.5, size = 4) +
  labs(
    title = "xP vs faktiske point",
    subtitle = "Hold over linjen har fået flere point end chancerne tilsagde",
    x = "Samlet xP",
    y = "Faktiske point",
    caption = "Kilde: Wyscout og egne simulationer"
  ) +
  theme_minimal()

# --------------------------------------------------
# 11. Visualisering: xP-difference pr. hold
# --------------------------------------------------
xp_table_plot <- xp_table %>%
  mutate(team_name = fct_reorder(team_name, xP_diff))

ggplot(xp_table_plot, aes(x = team_name, y = xP_diff, fill = xP_diff > 0)) +
  geom_col(width = 0.7) +
  geom_hline(yintercept = 0, linewidth = 0.8) +
  geom_text(
    aes(label = round(xP_diff, 2)),
    hjust = ifelse(xp_table_plot$xP_diff > 0, -0.15, 1.15),
    size = 3.5
  ) +
  coord_flip() +
  scale_fill_manual(values = c("TRUE" = "darkgreen", "FALSE" = "firebrick")) +
  labs(
    title = "Afvigelse mellem xP og faktiske point",
    subtitle = "Positive værdier = holdet burde have haft flere point",
    x = "",
    y = "xP - faktiske point",
    caption = "Kilde: Wyscout og egne simulationer"
  ) +
  theme_minimal() +
  theme(legend.position = "none")


# -------------------------------------------------
# 12. barplort
# --------------------------------------------------
library(dplyr)
library(tidyr)
library(ggplot2)

barplot_data <- xp_table %>%
  select(team_name, samlet_xP, faktiske_point) %>%
  pivot_longer(
    cols = c(samlet_xP, faktiske_point),
    names_to = "type",
    values_to = "value"
  ) %>%
  mutate(
    type = recode(type,
                  "samlet_xP" = "xP",
                  "faktiske_point" = "Faktiske point")
  )

ggplot(barplot_data, aes(x = reorder(team_name, value), y = value, fill = type)) +
  geom_col(position = "dodge") +
  coord_flip() +
  labs(
    title = "xP vs faktiske point pr. hold",
    subtitle = "Sammenligning mellem forventede og opnåede point",
    x = "",
    y = "Point",
    fill = "",
    caption = "Kilde: Wyscout og egne beregninger"
  ) +
  theme_minimal()


dumbbell_data <- xp_table %>%
  mutate(team_name = reorder(team_name, samlet_xP))

ggplot(dumbbell_data, aes(y = team_name)) +
  geom_segment(aes(x = samlet_xP, xend = faktiske_point, yend = team_name),
               linewidth = 1.2, color = "grey70") +
  geom_point(aes(x = samlet_xP), size = 3) +
  geom_point(aes(x = faktiske_point), size = 3) +
  labs(
    title = "Afvigelse mellem xP og faktiske point",
    subtitle = "Afstand viser over- eller underperformance",
    x = "Point",
    y = "",
    caption = "Kilde: Wyscout og egne simulationer"
  ) +
  theme_minimal()
