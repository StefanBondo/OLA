kamp1 <- kamp1 %>% 
  mutate(
    pass_success = case_when(
      SECONDARYTYPE1 == "loss" ~ "unsuccessful",
      SECONDARYTYPE2 == "loss" ~ "unsuccessful",
      SECONDARYTYPE3 == "loss" ~ "unsuccessful",
      TRUE ~ "successful"
    )
  )


kamp1 <- kamp1 %>% 
  mutate(
    isAssist = case_when(
      grepl("assist", SECONDARYTYPE1) ~ "isAssist",
      grepl("assist", SECONDARYTYPE2) ~ "isAssist",
      grepl("assist", SECONDARYTYPE3) ~ "isAssist",
      grepl("assist", SECONDARYTYPE4) ~ "isAssist",
      grepl("assist", SECONDARYTYPE5) ~ "isAssist",
      grepl("assist", SECONDARYTYPE6) ~ "isAssist",
      TRUE ~ "notAssist"
    )
  )





kamp1_plot <- kamp1 %>% 
  filter(passer_name == "Denis Vavro") %>% 
  drop_na(ENDLOCATIONX, ENDLOCATIONY, LENGTH, ANGLE) %>% 
  mutate(
    angle_rad = ANGLE * pi / 180,
    
    # slutpunkt skaleret til 120x80
    xend = ENDLOCATIONX * 120 / 100,
    yend = ENDLOCATIONY * 80 / 100,
    
    # delta i 0-100 skala -> skaler også delta til 120x80
    dx = (LENGTH * cos(angle_rad)) * 120 / 100,
    dy = (LENGTH * sin(angle_rad)) * 80 / 100,
    
    # startpunkt
    x = xend - dx,
    y = yend - dy
  )

start_points <- kamp1_plot %>%
  mutate(point_type = "Startpunkt")

end_points <- kamp1_plot %>%
  mutate(point_type = "Slutpunkt")

ggplot() +
  annotate_pitch(
    dimensions = pitch_statsbomb,
    fill = "darkgreen",
    colour = "white"
  ) +
  
  # Afleveringer (linjer)
  geom_segment(
    data = kamp1_plot,
    aes(
      x = x, y = y,
      xend = xend, yend = yend,
      color = pass_success
    ),
    alpha = 0.6
  ) +
  
  # Startpunkt
  geom_point(
    data = start_points,
    aes(x = x, y = y, color = point_type),
    size = 1.6
  ) +
  
  # Slutpunkt
  geom_point(
    data = end_points,
    aes(x = xend, y = yend, color = point_type),
    size = 1.6
  ) +
  
  labs(
    title = "Oversigt over afleveringer fra assist som har medført mål",
    color = "Forklaring"
  ) +
  
  scale_color_manual(
    values = c(
      "successful" = "blue",
      "unsuccessful" = "red",
      "Startpunkt" = "yellow",
      "Slutpunkt" = "lightgreen"
    )
  ) +
  
  coord_fixed(
    xlim = c(0, 120),
    ylim = c(0, 80),
    expand = FALSE
  ) +
  theme_pitch()


### CLustering

set.seed(123)

kamp1_cluster <- kamp1_plot %>% 
  select(xend, yend) %>% 
  kmeans(centers = 3)

kamp1_plot$cluster <- as.factor(kamp1_cluster$cluster)


ggplot(kamp1_plot) +
  annotate_pitch(dimensions = pitch_statsbomb, fill = "darkgreen", colour = "white") +
  geom_point(
    aes(x = xend, y = yend, color = cluster, shape = pass_success),
    size = 2,
    alpha = 0.8
  ) +
  scale_shape_manual(
    values = c(
      "successful" = 17,   # trekant
      "unsuccessful" = 16  # rund
    )
  ) +
  coord_fixed(xlim = c(0, 120), ylim = c(0, 80), expand = FALSE) +
  theme_pitch()



