afl <- "
SELECT
    p.EVENT_WYID,
    p.MATCH_WYID,
    p.COMPETITION_WYID,

    -- kampinfo
    m.DATE        AS match_date,
    m.MATCHLABEL AS match_label,
    
    -- tidspunkt info
    c.MATCHPERIOD,
    c.MINUTE,
    c.SECOND,

    -- hold
    c.TEAM_WYID,
    t.TEAMNAME AS team_name,

    -- passer
    c.PLAYER_WYID          AS passer_wyid,
    pp.player_name         AS passer_name,

    -- recipient
    p.RECIPIENT_WYID       AS recipient_wyid,
    pr.player_name         AS recipient_name,

    -- pass info
    p.PRIMARYTYPE,
    p.ACCURATE,
    p.ANGLE,
    p.HEIGHT,
    p.LENGTH,
    p.ENDLOCATIONX,
    p.ENDLOCATIONY,

    -- secondary types
    st.PRIMARYTYPE         AS secondary_primarytype,
    st.SECONDARYTYPE1,
    st.SECONDARYTYPE2,
    st.SECONDARYTYPE3,
    st.SECONDARYTYPE4,
    st.SECONDARYTYPE5,
    st.SECONDARYTYPE6,
    st.SECONDARYTYPE7

FROM wyscout_matchevents_passes p

LEFT JOIN wyscout_matchevents_common c
  ON p.EVENT_WYID = c.EVENT_WYID

LEFT JOIN wyscout_matches m
  ON p.MATCH_WYID = m.MATCH_WYID

LEFT JOIN wyscout_teams t
  ON c.TEAM_WYID = t.TEAM_WYID

LEFT JOIN (
    SELECT PLAYER_WYID, MAX(CONCAT(FIRSTNAME, ' ', LASTNAME)) AS player_name
    FROM wyscout_players
    GROUP BY PLAYER_WYID
) pp
  ON c.PLAYER_WYID = pp.PLAYER_WYID

LEFT JOIN (
    SELECT PLAYER_WYID, MAX(CONCAT(FIRSTNAME, ' ', LASTNAME)) AS player_name
    FROM wyscout_players
    GROUP BY PLAYER_WYID
) pr
  ON p.RECIPIENT_WYID = pr.PLAYER_WYID

LEFT JOIN wyscout_matchevents_secondarytype st
  ON p.EVENT_WYID = st.EVENT_WYID

WHERE p.PRIMARYTYPE = 'pass';
"


