library(dplyr)
library(stringr)
library(ggplot2)

direction_passes <- kamp1 %>%
  distinct(EVENT_WYID, .keep_all = TRUE) %>%
  filter(passer_name == "Rasmus Falk Jensen") %>%
  mutate(
    # Byg st_all robust (giver aldrig NA)
    st_all = paste(
      SECONDARYTYPE1, SECONDARYTYPE2, SECONDARYTYPE3,
      SECONDARYTYPE4, SECONDARYTYPE5, SECONDARYTYPE6, SECONDARYTYPE7
    ),
    st_all = str_replace_all(st_all, "NA", ""),   # ryd op
    st_all = str_squish(st_all),
    
    # Retning
    direction = case_when(
      str_detect(st_all, "forward_pass")  ~ "Fremad",
      str_detect(st_all, "back_pass")     ~ "Tilbage",
      str_detect(st_all, "lateral_pass")  ~ "Sideværts",
      TRUE                                ~ "Ukendt"
    )
  )

direction_summary <- direction_passes %>%
  count(direction) %>%
  filter(direction != "Ukendt")

ggplot(direction_summary, aes(x = direction, y = n, fill = direction)) +
  geom_col() +
  geom_text(aes(label = n), vjust = -0.3) +
  labs(
    title = "Rasmus Falk – afleveringsretning (kamp 1)",
    x = "",
    y = "Antal afleveringer"
  ) +
  expand_limits(y = max(direction_summary$n) * 1.15) +
  theme_minimal() +
  guides(fill = "none")
