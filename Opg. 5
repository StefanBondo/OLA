# Enkle t-tests som "statistisk belæg"
run_ttest <- function(df, varname) {
  f <- as.formula(paste0(varname, " ~ gender"))
  out <- tryCatch(t.test(f, data = df), error = function(e) NULL)
  if (is.null(out)) return(tibble(metric = varname, p_value = NA_real_, conf_low = NA_real_, conf_high = NA_real_))
  tibble(
    metric = varname,
    p_value = out$p.value,
    conf_low = out$conf.int[1],
    conf_high = out$conf.int[2]
  )
}

ttest_results <- bind_rows(
  run_ttest(match_profile, "passes"),
  run_ttest(match_profile, "pass_success_rate"),
  run_ttest(match_profile, "mean_pass_length"),
  run_ttest(match_profile, "shots"),
  run_ttest(match_profile, "mean_shot_xg"),
  run_ttest(match_profile, "dribble_success_rate"),
  run_ttest(match_profile, "pressure_rate")
