# -----------------------------
# 3) Opgave 5.2 - Freeze frame
# -----------------------------
# Hypotese:
# "Større andel af skud hos mænd burde have været aflevering til bedre placeret medspiller"
#
# Justering:
# En medspiller tæller KUN som bedre mulighed, hvis:
# 1) spilleren har en bedre scoringsposition end skytten
# 2) der IKKE står en modstander i afleveringsbanen mellem skytte og medspiller

freeze_shots <- EventsCombined %>%
  filter(
    type.name == "Shot",
    !is.na(shot.freeze_frame),
    !is.na(location)
  ) %>%
  mutate(
    sx = map_dbl(location, ~ extract_xy(.x)[1]),
    sy = map_dbl(location, ~ extract_xy(.x)[2])
  ) %>%
  filter(!is.na(sx), !is.na(sy))

# -----------------------------
# Hjælpefunktioner
# -----------------------------

extract_ff_xy <- function(ff_loc) {
  if (is.null(ff_loc) || length(ff_loc) < 2) {
    return(c(NA_real_, NA_real_))
  }
  c(as.numeric(ff_loc[[1]]), as.numeric(ff_loc[[2]]))
}

score_position <- function(px, py, opp_count) {
  # Mere "åben" vinkel + færre modstandere giver højere score
  angle <- mxangle(c(px, py))
  dist  <- disttogoal(c(px, py))
  area  <- calculate_triangle_area_goal(px, py)
  
  # Enkel, forklarbar sammensat score
  (angle * sqrt(area)) / ((1 + opp_count) * (1 + dist / 10))
}

# Afstand fra punkt til linjestykke
point_to_segment_distance <- function(px, py, x1, y1, x2, y2) {
  dx <- x2 - x1
  dy <- y2 - y1
  
  if (dx == 0 && dy == 0) {
    return(sqrt((px - x1)^2 + (py - y1)^2))
  }
  
  t <- ((px - x1) * dx + (py - y1) * dy) / (dx^2 + dy^2)
  t <- max(0, min(1, t))
  
  proj_x <- x1 + t * dx
  proj_y <- y1 + t * dy
  
  sqrt((px - proj_x)^2 + (py - proj_y)^2)
}

# Tjekker om en modstander står i afleveringsbanen mellem skytte og medspiller
is_opponent_blocking_pass_lane <- function(ox, oy, sx, sy, tx, ty,
                                           lane_width = 2.5,
                                           min_along = 0.05,
                                           max_along = 0.95) {
  dx <- tx - sx
  dy <- ty - sy
  seg_len2 <- dx^2 + dy^2
  
  if (seg_len2 == 0) return(FALSE)
  
  # Position langs afleveringslinjen:
  # t = 0 ved skytten, t = 1 ved modtageren
  t <- ((ox - sx) * dx + (oy - sy) * dy) / seg_len2
  
  # Kun modstandere der faktisk står mellem skytte og modtager tæller
  if (t <= min_along || t >= max_along) return(FALSE)
  
  dist_line <- point_to_segment_distance(ox, oy, sx, sy, tx, ty)
  
  dist_line <= lane_width
}

evaluate_shot_option <- function(shot_row) {
  ff <- shot_row$shot.freeze_frame[[1]]
  
  if (is.null(ff) || nrow(ff) == 0) {
    return(tibble(
      has_better_option = NA,
      best_delta = NA_real_,
      best_tx = NA_real_,
      best_ty = NA_real_
    ))
  }
  
  ff <- as_tibble(ff)
  
  if (!("teammate" %in% names(ff)) || !("location" %in% names(ff))) {
    return(tibble(
      has_better_option = NA,
      best_delta = NA_real_,
      best_tx = NA_real_,
      best_ty = NA_real_
    ))
  }
  
  ff <- ff %>%
    mutate(
      px = map_dbl(location, ~ extract_ff_xy(.x)[1]),
      py = map_dbl(location, ~ extract_ff_xy(.x)[2])
    ) %>%
    filter(!is.na(px), !is.na(py))
  
  if (nrow(ff) == 0) {
    return(tibble(
      has_better_option = NA,
      best_delta = NA_real_,
      best_tx = NA_real_,
      best_ty = NA_real_
    ))
  }
  
  opponents <- ff %>% filter(teammate == FALSE)
  teammates <- ff %>% filter(teammate == TRUE)
  
  if (nrow(teammates) == 0) {
    return(tibble(
      has_better_option = FALSE,
      best_delta = NA_real_,
      best_tx = NA_real_,
      best_ty = NA_real_
    ))
  }
  
  shooter_x <- shot_row$sx
  shooter_y <- shot_row$sy
  
  # Hvor mange modstandere står i skyttens vinkel mod mål?
  shooter_opp <- if (nrow(opponents) == 0) {
    0
  } else {
    sum(
      mapply(
        is_opponent_inside_triangle,
        opponents$px,
        opponents$py,
        MoreArgs = list(shooter_x = shooter_x, shooter_y = shooter_y)
      )
    )
  }
  
  shooter_score <- score_position(shooter_x, shooter_y, shooter_opp)
  
  teammate_eval <- teammates %>%
    rowwise() %>%
    mutate(
      # Ny logik: afleveringslinjen skal være fri
      pass_blocked = if (nrow(opponents) == 0) {
        FALSE
      } else {
        any(
          mapply(
            is_opponent_blocking_pass_lane,
            opponents$px,
            opponents$py,
            MoreArgs = list(
              sx = shooter_x,
              sy = shooter_y,
              tx = px,
              ty = py,
              lane_width = 2.5
            )
          )
        )
      },
      
      # Hvor mange modstandere står i modtagerens vinkel mod mål?
      opp_in_tri = if (nrow(opponents) == 0) {
        0
      } else {
        sum(
          mapply(
            is_opponent_inside_triangle,
            opponents$px,
            opponents$py,
            MoreArgs = list(shooter_x = px, shooter_y = py)
          )
        )
      },
      
      # Hvis afleveringen er blokeret, skal spilleren ikke tælle som mulighed
      pos_score = ifelse(
        pass_blocked,
        NA_real_,
        score_position(px, py, opp_in_tri)
      ),
      
      delta = pos_score - shooter_score
    ) %>%
    ungroup() %>%
    filter(!pass_blocked) %>%
    arrange(desc(delta))
  
  if (nrow(teammate_eval) == 0) {
    return(tibble(
      has_better_option = FALSE,
      best_delta = NA_real_,
      best_tx = NA_real_,
      best_ty = NA_real_
    ))
  }
  
  best <- teammate_eval %>% slice(1)
  
  # Krav: mindst 10% bedre score for at tælle som klart bedre placeret
  has_better <- is.finite(best$delta) && (best$delta > abs(shooter_score) * 0.10)
  
  tibble(
    has_better_option = has_better,
    best_delta = best$delta,
    best_tx = best$px,
    best_ty = best$py
  )
}

