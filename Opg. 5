# -----------------------------
case_plot <- function(shot_row, title_text) {
  ff <- shot_row$shot.freeze_frame[[1]]
  if (is.null(ff) || nrow(ff) == 0) return(NULL)
  
  ff <- as_tibble(ff) %>%
    mutate(
      x = map_dbl(location, ~ extract_ff_xy(.x)[1]),
      y = map_dbl(location, ~ extract_ff_xy(.x)[2]),
      who = ifelse(teammate, "Teammate", "Opponent")
    ) %>%
    filter(!is.na(x), !is.na(y))
  
  sx <- shot_row$sx
  sy <- shot_row$sy
  tx <- shot_row$best_tx
  ty <- shot_row$best_ty
  
  p <- ggplot() +
    annotate_pitch(dimensions = pitch_statsbomb, colour = "grey30", fill = "white") +
    geom_point(data = ff, aes(x, y, color = who), size = 2.8, alpha = 0.85) +
    geom_point(aes(x = sx, y = sy), size = 4, color = "goldenrod3") +
    geom_segment(aes(x = sx, y = sy, xend = 120, yend = 36), linetype = "dashed", color = "goldenrod3") +
    geom_segment(aes(x = sx, y = sy, xend = 120, yend = 44), linetype = "dashed", color = "goldenrod3") +
    geom_point(aes(x = tx, y = ty), size = 4, color = "darkgreen") +
    geom_segment(aes(x = tx, y = ty, xend = 120, yend = 36), linetype = "dashed", color = "darkgreen") +
    geom_segment(aes(x = tx, y = ty, xend = 120, yend = 44), linetype = "dashed", color = "darkgreen") +
    coord_flip(xlim = c(75, 121)) +
    scale_y_reverse() +
    theme_pitch() +
    scale_color_manual(values = c("Teammate" = "#2e7d32", "Opponent" = "#b71c1c")) +
    labs(
      title = title_text,
      subtitle = "Gul = skytte, Grøn = bedst placeret medspiller"
    )
  
  p
}

