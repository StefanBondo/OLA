calcdist <- function(rawin) {
  retval=0L
  v=as.numeric(unlist(stri_split(rawin,regex = "\n",omit_empty=T)))
  brutlist=sort(abs(unique(diff(v))))
  log_print(brutlist)
  retval=sum(brutlist > difflimit)
  #print(retval)
  return(round(retval/2))
}

