
for (i in seq_len(nrow(tillid_negativ))) {
  # Hent værdierne for ét kvartal
  x <- as.numeric(tillid_negativ[i, 3:ncol(tillid_negativ), drop = FALSE])
  
  # Lav alle kombinationer (k = 2..antal spørgsmål)
  combs_all <- lapply(1:length(x), function(k) combn(x, k, simplify = TRUE))
  
  # Beregn gennemsnit for hver kombination (kolonne i matrixen)
  means_all <- lapply(combs_all, function(mat) colMeans(mat))
  
  # Gem resultater
  comliste2[[i]] <- combs_all
  indikatorliste[[i]] <- means_all
}

# Navngiv efter kvartal
names(comliste2) <- tillid_negativ$Kvartal
names(indikatorliste) <- tillid_negativ$Kvartal


indikator_df <- data.frame()  # tom data frame til alt output

for (i in seq_len(nrow(tillid_negativ))) {
  # Hent værdier for ét kvartal
  x <- as.numeric(tillid_negativ[i, 3:ncol(tillid_negativ), drop = FALSE])
  
  # Gå igennem alle kombinationsstørrelser
  for (k in 1:length(x)) {
    # Lav kombinationer for denne størrelse
    mat <- combn(x, k, simplify = TRUE)
    
    # Beregn gennemsnit for hver kolonne (hver kombination)
    means_k <- colMeans(mat)
    
    # Opret midlertidig data.frame med resultaterne
    df_k <- data.frame(
      kvartal = tillid_negativ$Kvartal[i],
      k = k,
      komb_nr = seq_along(means_k),
      mean = means_k
    )
    
    # Tilføj til hoved-dataframe
    indikator_df <- rbind(indikator_df, df_k)
  }
}

indikator_df$mean <- round(indikator_df$mean,2)



## 2) Rens kvartal-felt (fjern mellemrum) og join 
indikator_df <- indikator_df %>%
  mutate(Kvartal = gsub(" ", "", Kvartal))

samlet_forbrug <- samlet_forbrug %>%
  mutate(Kvartal = gsub(" ", "", Kvartal))


merged_negativ <- indikator_df %>%
  inner_join(samlet_forbrug, by = c("Kvartal" = "Kvartal"))


# Tjek at de centrale kolonner findes
stopifnot(all(c("komb_nr", "mean", "real_vækst_pct") %in% names(merged_negativ)))

library(dplyr)
library(purrr)
library(tidyr)

# 0) Peg på de 12 spørgsmål i tillid_mikro (justér, hvis de ligger andre steder end 3:14)
spm_idx    <- 6:17
spm_navne  <- names(merged_negativ)[spm_idx]

# 1) Lav et opslagskatalog: for hver k (1..12) alle kombinationer og deres kolonneindeks + navne
combo_labels <- map2_dfr(
  .x = lapply(1:length(spm_idx), function(k) combn(spm_idx, k, simplify = FALSE)),
  .y = 1:length(spm_idx),
  .f = function(lst, k) {
    tibble(
      k       = k,
      komb_nr = seq_along(lst),
      col_idx = lst
    )
  }
) %>%
  mutate(
    spm_navne = map(col_idx, ~ spm_navne[match(.x, spm_idx)]),  # sikre korrekt mapping
    label     = map_chr(spm_navne, ~ paste(.x, collapse = " + "))
  )

# 2) Din R²-funktion (uændret)
r2_fun <- function(df) {
  if (nrow(df) < 3 || var(df$mean, na.rm = TRUE) == 0) return(NA_real_)
  summary(lm(real_vækst_pct ~ mean, data = df))$r.squared
}

# 3) Beregn R² pr. (k, komb_nr) og join med labels
r2_resultater_negativ <- merged_negativ %>%
  group_by(k, komb_nr) %>%                                # ← vigtig: både k og komb_nr
  summarise(R2 = r2_fun(cur_data()), .groups = "drop") %>%
  inner_join(combo_labels, by = c("k", "komb_nr")) %>%
  arrange(desc(R2))

vinder <- r2_resultater_negativ %>% slice(5)
vinder$k; vinder$komb_nr; vinder$label
