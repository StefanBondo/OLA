  ) +
  # Akser
  scale_y_continuous(
    name = "DI's & DST forbrugertillidsindikator (nettotal)",
    sec.axis = sec_axis(~ . / scale_factor, name = "Årlig realvækst (pct.)")
  ) +
  scale_x_date(date_breaks = "1 year", date_labels = "%y") +
  # Farver/labels i legend
  scale_fill_manual(
