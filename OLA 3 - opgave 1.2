# --- 3) Vælg automatisk skaleringsfaktor til højre akse (sd-match) ---
sd_ind <- sd(c(tillid_2025$di_gennemsnit,
               vores_indikator$gennemsnit), na.rm = TRUE)
sd_rv  <- sd(vores_indikator$real_vækst_pct, na.rm = TRUE)
scale_factor <- ifelse(is.finite(sd_ind/sd_rv), sd_ind/sd_rv, 1)

ggplot() +
  # Blå søjler: årlig realvækst (pct.)
  geom_col(
    data = vores_indikator,
    aes(x = .data$Kvartal, y = .data$real_vækst_pct * scale_factor,
        fill = "Årlig realvækst (pct.)"),
    width = 80
  ) +
  # DI’s indikator (grå)
  geom_line(
    data = tillid_2025,
    aes(x = .data$Kvartal, y = .data$di_gennemsnit, colour = "DI's indikator"),
    linewidth = 0.6
  ) +
  # Tillid_mikro's gennemsnit som "Vores indikator" (grøn)
  geom_line(
    data = vores_indikator,
    aes(x = .data$Kvartal, y = .data$gennemsnit, colour = "Vores indikator"),
    linewidth = 0.6,
