library(serial)

# Opret forbindelse til Arduino
conarduino <- serialConnection(
  name = "mytest",
  port = "cu.usbmodem146101",   # tilpas hvis nødvendigt
  mode = "9600,n,8,1",
  newline = 1,
  translation = "cr",
  handshake = "xonxoff",
  buffersize = 4096
)

open(conarduino)

# Kolonnenavne og tomt data frame
dfnames <- c("people", "timestamp")
totaldf <- data.frame(
  people    = integer(),
  timestamp = as.POSIXct(character())
)

# Tærskel for "person foran sensor" (skal evt. kalibreres)
threshold    <- 100
prev_blocked <- FALSE   # stod der en person der før?
people_total <- 0L      # samlet antal personer

# Kør i fx 60 sekunder
stoptime <- Sys.time() + 60

while (Sys.time() < stoptime) {
  # Læs én måling fra Arduino – fx "123"
  raw_val  <- read.serialConnection(conarduino)
  dist_val <- as.numeric(raw_val)
  
  # Hvis vi ikke fik et tal, så spring iterationen over
  if (is.na(dist_val)) {
    next
  }
  
  # Er der en person foran sensoren?
  blocked <- dist_val < threshold
  
  # Overgang fra "ingen person" -> "person": tæl én
  if (!prev_blocked && blocked) {
    people_total <- people_total + 1L
  }
  
  # Opdater tilstand
  prev_blocked <- blocked
  
  # Tilføj række til totaldf
  totaldf <- rbind(
    totaldf,
    data.frame(
      people    = people_total,
      timestamp = Sys.time()
    )
  )
  
  flush(conarduino)
  Sys.sleep(0.2)   # juster hvis du vil måle hurtigere/langsommere
}

close(conarduino)

totaldf
