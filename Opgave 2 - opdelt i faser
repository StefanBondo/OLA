# --------------------------------------------------
# 8. SAMLET TABEL MED FASER
# --------------------------------------------------
xp_faser <- xp_phase %>%
  group_by(fase, team_name) %>%
  summarise(
    kampe = n(),
    xP = sum(xP, na.rm = TRUE),
    point = sum(faktiske_point, na.rm = TRUE),
    diff = xP - point,
    .groups = "drop"
  ) %>%
  mutate(
    xP = round(xP, 2),
    diff = round(diff, 2)
  ) %>%
  arrange(fase, desc(xP))

xp_faser

# --------------------------------------------------
# 9. BRØNDBY OPDELT
# --------------------------------------------------
brondby_faser <- xp_phase %>%
  filter(team_name == "Brøndby") %>%
  group_by(fase) %>%
  summarise(
    kampe = n(),
    xP = round(sum(xP, na.rm = TRUE), 2),
    point = sum(faktiske_point, na.rm = TRUE),
    diff = round(sum(xP, na.rm = TRUE) - sum(faktiske_point, na.rm = TRUE), 2),
    .groups = "drop"
  )

brondby_faser

