# =========================================================
# KRAV: disse objekter skal findes i environment
# =========================================================
required_objects <- c("xp_table", "xp_match_results", "grundspil_table", "xp_mesterskab", "xp_kvalifikation", "xp_data")

missing_objects <- required_objects[!sapply(required_objects, exists)]

if (length(missing_objects) > 0) {
  stop(
    paste(
      "Følgende objekter mangler i environment:",
      paste(missing_objects, collapse = ", "),
      "\nKør xP-analyserne først."
    )
  )
}

# =========================================================
# KLARGØR DATA
# =========================================================
xp_table <- xp_table %>%
  mutate(
    xP_diff = round(xP_diff, 2)
  )

xp_match_results <- xp_match_results %>%
  mutate(
    xP = round(xP, 3),
    win_prob = round(win_prob, 3),
    draw_prob = round(draw_prob, 3),
    loss_prob = round(loss_prob, 3)
  )

# Tilføj match_date hvis muligt
xp_phase <- xp_match_results %>%
  left_join(
    xp_data %>% distinct(MATCH_WYID, match_date),
    by = "MATCH_WYID"
  ) %>%
  arrange(team_name, match_date, MATCH_WYID)

# Nummerer kampe pr. hold
xp_phase <- xp_phase %>%
  group_by(team_name) %>%
  mutate(kamp_nr = row_number()) %>%
  ungroup()

# Hvis fase ikke allerede findes, lav den
if (!"fase" %in% names(xp_phase)) {
  grundspil_table_internal <- xp_phase %>%
    filter(kamp_nr <= 22) %>%
    group_by(team_name) %>%
    summarise(
      point = sum(faktiske_point, na.rm = TRUE),
      xP = sum(xP, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    arrange(desc(point), desc(xP))
  
  mesterskabshold <- grundspil_table_internal %>%
    slice(1:6) %>%
    pull(team_name)
  
  xp_phase <- xp_phase %>%
    mutate(
      fase = case_when(
        kamp_nr <= 22 ~ "Grundspil",
        kamp_nr > 22 & team_name %in% mesterskabshold ~ "Mesterskabsspil",
        TRUE ~ "Kvalifikationsspil"
      )
    )
}

