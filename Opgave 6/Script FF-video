get_frame_row <- function(frame_id, tracking_df) {
  row <- tracking_df %>%
    filter(frame_idx == frame_id)
  
  if (nrow(row) != 1) {
    stop("Kunne ikke finde præcis én række for frame_idx = ", frame_id)
  }
  
  row
}

clip_points_to_pitch <- function(pts, pitch_xlim, pitch_ylim, eps = 0.001) {
  pts %>%
    mutate(
      x = pmin(pmax(x, pitch_xlim[1] + eps), pitch_xlim[2] - eps),
      y = pmin(pmax(y, pitch_ylim[1] + eps), pitch_ylim[2] - eps)
    )
}

frame_to_points <- function(frame_row, player_lookup_df) {
  vals <- as.character(unlist(frame_row[1, ], use.names = FALSE))
  
  if (length(vals) < 68) {
    stop("Frame-rækken er kortere end forventet.")
  }
  
  home_ids <- vals[3:13]
  away_ids <- vals[36:46]
  
  home_x <- suppressWarnings(as.numeric(vals[14:24]))
  home_y <- suppressWarnings(as.numeric(vals[25:35]))
  away_x <- suppressWarnings(as.numeric(vals[47:57]))
  away_y <- suppressWarnings(as.numeric(vals[58:68]))
  
  pts <- tibble(
    ssiId = c(home_ids, away_ids),
    x = c(home_x, away_x),
    y = c(home_y, away_y)
  ) %>%
    left_join(player_lookup_df, by = "ssiId") %>%
    mutate(
      player_name = ifelse(is.na(player_name), ssiId, player_name),
      team = ifelse(is.na(team), "Ukendt", team)
    )
  
  as.data.frame(pts)
}

frame_ball <- function(frame_row) {
  vals <- as.character(unlist(frame_row[1, ], use.names = FALSE))
  
  ball_x <- if (length(vals) >= 69) suppressWarnings(as.numeric(vals[69])) else NA_real_
  ball_y <- if (length(vals) >= 70) suppressWarnings(as.numeric(vals[70])) else NA_real_
  
  data.frame(x = ball_x, y = ball_y)
}

get_frame_sequence <- function(start_frame, tracking_df, n_frames = 75) {
  all_frames <- sort(unique(tracking_df$frame_idx))
  
  if (!(start_frame %in% all_frames)) {
    stop("start_frame findes ikke i tracking-data.")
  }
  
  start_pos <- match(start_frame, all_frames)
  end_pos <- min(start_pos + n_frames - 1, length(all_frames))
  
  all_frames[start_pos:end_pos]
}

compute_view_window <- function(
    pts,
    ball = NULL,
    pitch_xlim,
    pitch_ylim,
    zoom_til_data = FALSE,
    xlim = NULL,
    ylim = NULL,
    pad_zoom = 12,
    pad_view = 0
) {
  ball_xy <- if (!is.null(ball) &&
                 nrow(ball) == 1 &&
                 all(is.finite(c(ball$x, ball$y)))) {
    c(ball$x, ball$y)
  } else {
    numeric(0)
  }
  
  if (isTRUE(zoom_til_data) && is.null(xlim) && is.null(ylim)) {
    xv <- pts$x
    yv <- pts$y
    
    if (length(ball_xy) == 2) {
      xv <- c(xv, ball_xy[1])
      yv <- c(yv, ball_xy[2])
    }
    
    xr <- range(xv, na.rm = TRUE) + c(-pad_zoom, pad_zoom)
    yr <- range(yv, na.rm = TRUE) + c(-pad_zoom, pad_zoom)
    
    xr[1] <- max(xr[1], pitch_xlim[1])
    xr[2] <- min(xr[2], pitch_xlim[2])
    yr[1] <- max(yr[1], pitch_ylim[1])
    yr[2] <- min(yr[2], pitch_ylim[2])
  } else {
    xr <- if (is.null(xlim)) pitch_xlim + c(-pad_view, pad_view) else xlim
    yr <- if (is.null(ylim)) pitch_ylim + c(-pad_view, pad_view) else ylim
  }
  
  list(xlim = xr, ylim = yr)
}

# =========================================================
# 7. PLOTFUNKTIONER
# =========================================================

plot_tracking_frame <- function(
    pts,
    titel = "",
    ball = NULL,
    pitch_dims,
    pitch_xlim,
    pitch_ylim,
    zoom_til_data = FALSE,
    xlim = NULL,
    ylim = NULL,
    show_player_names = FALSE
) {
  vw <- compute_view_window(
    pts = pts,
    ball = ball,
    pitch_xlim = pitch_xlim,
    pitch_ylim = pitch_ylim,
    zoom_til_data = zoom_til_data,
    xlim = xlim,
    ylim = ylim
  )
  
  p <- ggplot() +
    annotate_pitch(
      dimensions = pitch_dims,
      fill = "#1b5e20",
      colour = "white",
      limits = FALSE
    ) +
    geom_point(
      data = pts,
      aes(x = x, y = y, fill = team),
      shape = 21,
      color = "black",
      size = 5
    ) +
    ggtitle(titel) +
    theme_pitch(aspect_ratio = NULL) +
    scale_x_continuous(limits = vw$xlim, expand = c(0, 0)) +
    scale_y_continuous(limits = vw$ylim, expand = c(0, 0)) +
    coord_fixed(ratio = 1)
  
  if (show_player_names) {
    p <- p +
      geom_text(
        data = pts,
        aes(x = x, y = y, label = player_name),
        size = 3,
        vjust = -1,
        color = "white"
      )
  }
  
  if (!is.null(ball) && nrow(ball) == 1 && all(is.finite(c(ball$x, ball$y)))) {
    p <- p +
      geom_point(
        data = ball,
        aes(x = x, y = y),
        inherit.aes = FALSE,
        shape = 21,
        fill = "white",
        color = "black",
        stroke = 1.2,
        size = 4,
        show.legend = FALSE
      )
  }
  
  p
}

plot_delaunay_frame <- function(
    pts,
    titel = "",
    ball = NULL,
    pitch_dims,
    pitch_xlim,
    pitch_ylim,
    zoom_til_data = FALSE,
    xlim = NULL,
    ylim = NULL,
    show_player_names = FALSE
) {
  tri_local <- deldir(
    pts$x, pts$y,
    rw = c(pitch_xlim[1], pitch_xlim[2], pitch_ylim[1], pitch_ylim[2])
  )
  seg <- tri_local$dirsgs
  
  vw <- compute_view_window(
    pts = pts,
    ball = ball,
    pitch_xlim = pitch_xlim,
    pitch_ylim = pitch_ylim,
    zoom_til_data = zoom_til_data,
    xlim = xlim,
    ylim = ylim
  )
  
  p <- ggplot() +
    annotate_pitch(
      dimensions = pitch_dims,
      fill = "#1b5e20",
      colour = "white",
      limits = FALSE
    ) +
    geom_segment(
      data = seg,
      aes(x = x1, y = y1, xend = x2, yend = y2),
      color = "white",
      linewidth = 0.5
    ) +
    geom_point(
      data = pts,
      aes(x = x, y = y, fill = team),
      shape = 21,
      color = "black",
      size = 5
    ) +
    ggtitle(titel) +
    theme_pitch(aspect_ratio = NULL) +
    scale_x_continuous(limits = vw$xlim, expand = c(0, 0)) +
    scale_y_continuous(limits = vw$ylim, expand = c(0, 0)) +
    coord_fixed(ratio = 1)
  
  if (show_player_names) {
    p <- p +
      geom_text(
        data = pts,
        aes(x = x, y = y, label = player_name),
        size = 3,
        vjust = -1,
        color = "white"
      )
  }
  
  if (!is.null(ball) && nrow(ball) == 1 && all(is.finite(c(ball$x, ball$y)))) {
    p <- p +
      geom_point(
        data = ball,
        aes(x = x, y = y),
        inherit.aes = FALSE,
        shape = 21,
        fill = "white",
        color = "black",
        stroke = 1.2,
        size = 4,
        show.legend = FALSE
      )
  }
  
  p
}

