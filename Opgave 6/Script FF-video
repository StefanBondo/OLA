make_tracking_video <- function(
    start_frame,
    tracking_df,
    player_lookup_df,
    pitch_dims,
    pitch_xlim,
    pitch_ylim,
    n_frames = 75,
    output_file = "tracking_sequence.mp4",
    fps = 10,
    zoom_til_data = FALSE,
    xlim = NULL,
    ylim = NULL,
    show_player_names = FALSE
) {
  frame_ids <- get_frame_sequence(
    start_frame = start_frame,
    tracking_df = tracking_df,
    n_frames = n_frames
  )
  
  if (length(frame_ids) < 2) {
    stop("For få frames fundet til at lave video.")
  }
  
  message("Genererer tracking-frames: ", length(frame_ids))
  
  out_dir <- file.path(tempdir(), "tracking_video_frames")
  dir.create(out_dir, showWarnings = FALSE, recursive = TRUE)
  
  image_files <- character(length(frame_ids))
  
  for (i in seq_along(frame_ids)) {
    fr <- frame_ids[i]
    
    frame_row <- get_frame_row(fr, tracking_df)
    
    pts <- frame_to_points(frame_row, player_lookup_df) %>%
      clip_points_to_pitch(pitch_xlim, pitch_ylim)
    
    ball <- frame_ball(frame_row)
    
    clock_txt <- if (!is.na(frame_row$game_clock[1])) {
      paste0(" | game_clock: ", round(frame_row$game_clock[1], 2))
    } else {
      ""
    }
    
    titel <- paste0("Tracking | Frame ", fr, clock_txt)
    
    p <- plot_tracking_frame(
      pts = pts,
      titel = titel,
      ball = ball,
      pitch_dims = pitch_dims,
      pitch_xlim = pitch_xlim,
      pitch_ylim = pitch_ylim,
      zoom_til_data = zoom_til_data,
      xlim = xlim,
      ylim = ylim,
      show_player_names = show_player_names
    )
    
    file_i <- file.path(out_dir, sprintf("frame_%04d.png", i))
    image_files[i] <- file_i
    
    ggsave(
      filename = file_i,
      plot = p,
      width = 10,
      height = 7,
      dpi = 150
    )
  }
  
  message("Sammensætter tracking-video ...")
  
  av::av_encode_video(
    input = image_files,
    output = output_file,
    framerate = fps
  )
  
  message("Tracking-video gemt som: ", normalizePath(output_file))
}

