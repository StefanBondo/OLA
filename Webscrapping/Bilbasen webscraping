#### Alle biler på Resten af siden

library(httr)
library(rvest)
library(dplyr)

startlink <- "https://www.bilbasen.dk/brugt/bil/volvo?fuel=1&includeengroscvr=true&includeleasing=false"

rawres <- GET(url = startlink)
rawcontent <- httr::content(rawres, as = "text")
page <- read_html(rawcontent)

# CSS-selectors
ptag <- ".Listing_price__6B3kE"
dettagitem <- "[class^='ListingDetails_listItem']"
mmtag <- "[class^='Listing_makeModel']"
desctag <- "[class^='Listing_description']"
loctag <- "[class^='Listing_location']"

# Dataframe til opsamling
cn <- c("price", "details", "makemodel", "description", "location", "scrapdate")
colldf <- data.frame(matrix(NA, ncol = length(cn)))
colnames(colldf) <- cn

# Hent alle biler på siden
carlist <- page %>% html_elements("article")

for (i in seq_along(carlist)) {
  car <- carlist[[i]]
  price <- car %>% html_element(ptag) %>% html_text(trim = TRUE)
  details <- car %>% html_elements(dettagitem) %>% html_text(trim = TRUE) %>% paste(collapse = " | ")
  makemodel <- car %>% html_element(mmtag) %>% html_text(trim = TRUE)
  description <- car %>% html_element(desctag) %>% html_text(trim = TRUE)
  location <- car %>% html_element(loctag) %>% html_text(trim = TRUE)
  
  tmpdf <- data.frame(price, details, makemodel, description, location, Sys.time())
  colldf <- rbind(colldf, tmpdf)
}

# Fjern første tomme række
colldf <- colldf[-1, ]
View(colldf)



##### Flere sider
all_pages <- data.frame()

for (page_num in 2:7) {
  url <- paste0("https://www.bilbasen.dk/brugt/bil/volvo?fuel=1&includeengroscvr=true&includeleasing=false&page=", page_num)
  rawres <- GET(url)
  page <- read_html(httr::content(rawres, as = "text"))
  
  carlist <- page %>% html_elements("article")
  
  for (car in carlist) {
    price <- car %>% html_element(ptag) %>% html_text(trim = TRUE)
    details <- car %>% html_elements(dettagitem) %>% html_text(trim = TRUE) %>% paste(collapse = " | ")
    makemodel <- car %>% html_element(mmtag) %>% html_text(trim = TRUE)
    description <- car %>% html_element(desctag) %>% html_text(trim = TRUE)
    location <- car %>% html_element(loctag) %>% html_text(trim = TRUE)
    tmpdf <- data.frame(price, details, makemodel, description, location, Sys.time())
    all_pages <- rbind(all_pages, tmpdf)
  }
}

View(all_pages)


#Rensning af frame
all_pages_clean <- all_pages %>%
  distinct(makemodel, price, location, .keep_all = TRUE)


