run_cluster_model <- function(df, vars, k) {
  feature_df <- df %>% select(all_of(vars))
  n_distinct_points <- nrow(distinct(feature_df))
  k_use <- min(k, max(1, n_distinct_points))
  
  if (k_use < 2) {
    df$cluster <- factor(1)
    return(list(data = df, centers = NULL, k_used = 1))
  }
  
  scaled <- scale(feature_df)
  set.seed(123)
  km <- kmeans(scaled, centers = k_use, nstart = 25)
  
  out <- df
  out$cluster <- factor(km$cluster)
  
  centers <- out %>%
    group_by(cluster) %>%
    summarise(across(all_of(vars), mean), .groups = "drop")
  
  list(data = out, centers = centers, k_used = k_use)
}

label_length_success_team <- function(df) {
  centers <- df %>%
    group_by(cluster) %>%
    summarise(
      mean_length = mean(mean_length),
      success_rate = mean(success_rate),
      .groups = "drop"
    )
  
  if (nrow(centers) == 3) {
    control_id <- centers %>% slice_min(mean_length, n = 1, with_ties = FALSE) %>% pull(cluster)
    direct_id  <- centers %>% slice_max(mean_length, n = 1, with_ties = FALSE) %>% pull(cluster)
    
    df %>%
      mutate(
        cluster_name = case_when(
          cluster == control_id ~ "Kontrollerende possessionshold",
          cluster == direct_id ~ "Direkte og risikobaserede hold",
          TRUE ~ "Balancerede hold"
        )
      )
  } else {
    ranked <- centers %>% arrange(mean_length)
    map <- c(
      "Kontrollerende possessionshold",
      "Balancerede hold",
      "Direkte hold",
      "Meget direkte og risikobaserede hold"
    )
    label_map <- setNames(map[seq_len(nrow(ranked))], ranked$cluster)
    
    df %>% mutate(cluster_name = unname(label_map[as.character(cluster)]))
  }
}

label_length_success_player <- function(df) {
  centers <- df %>%
    group_by(cluster) %>%
    summarise(
      mean_length = mean(mean_length),
      success_rate = mean(success_rate),
      .groups = "drop"
    )
  
  if (nrow(centers) == 3) {
    direct_id <- centers %>% slice_max(mean_length, n = 1, with_ties = FALSE) %>% pull(cluster)
    remaining <- centers %>% filter(cluster != direct_id)
    safe_id <- remaining %>% slice_max(success_rate, n = 1, with_ties = FALSE) %>% pull(cluster)
    
    df %>%
      mutate(
        cluster_name = case_when(
          cluster == safe_id ~ "Boldsikre opspilsspillere",
          cluster == direct_id ~ "Direkte og risikobaserede spillere",
          TRUE ~ "Korte kombinationsspillere"
        )
      )
  } else {
    ranked <- centers %>% arrange(mean_length)
    map <- c(
      "Korte kombinationsspillere",
      "Boldsikre opspilsspillere",
      "Balancerede boldfordelere",
      "Direkte og risikobaserede spillere"
    )
    label_map <- setNames(map[seq_len(nrow(ranked))], ranked$cluster)
    
    df %>% mutate(cluster_name = unname(label_map[as.character(cluster)]))
  }
}

label_progressive_success_team <- function(df) {
  centers <- df %>%
    group_by(cluster) %>%
    summarise(
      progressive_rate = mean(progressive_rate),
      success_rate = mean(success_rate),
      .groups = "drop"
    )
  
  if (nrow(centers) == 3) {
    control_id <- centers %>% slice_min(progressive_rate, n = 1, with_ties = FALSE) %>% pull(cluster)
    risky_id <- centers %>%
      mutate(score = progressive_rate - success_rate) %>%
      slice_max(score, n = 1, with_ties = FALSE) %>%
      pull(cluster)
    
    df %>%
      mutate(
        cluster_name = case_when(
          cluster == control_id ~ "Kontrollerende possessionshold",
          cluster == risky_id ~ "Risikobaserede progressionshold",
          TRUE ~ "Balancerede hold"
        )
      )
  } else {
    centers2 <- centers %>%
      mutate(
        play_score = progressive_rate + success_rate,
        risky_score = progressive_rate - success_rate
      )
    
    control_id <- centers2 %>% slice_min(progressive_rate, n = 1, with_ties = FALSE) %>% pull(cluster)
    risky_id   <- centers2 %>% slice_max(risky_score, n = 1, with_ties = FALSE) %>% pull(cluster)
    effective_id <- centers2 %>%
      filter(!cluster %in% c(control_id, risky_id)) %>%
      slice_max(play_score, n = 1, with_ties = FALSE) %>%
      pull(cluster)
    
    df %>%
      mutate(
        cluster_name = case_when(
          cluster == control_id ~ "Kontrollerende possessionshold",
          cluster == effective_id ~ "Effektive progressionshold",
          cluster == risky_id ~ "Risikobaserede progressionshold",
          TRUE ~ "Balancerede hold"
        )
      )
  }
}

