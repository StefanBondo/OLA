    layout(
      title = list(text = title, x = 0.02, xanchor = "left", font = list(size = 18)),
      paper_bgcolor = "rgba(0,0,0,0)",
      plot_bgcolor = "#ffffff",
      xaxis = list(title = nice_axis_label(x_var), gridcolor = "#e5e7eb", zeroline = FALSE),
      yaxis = list(title = nice_axis_label(y_var), gridcolor = "#e5e7eb", zeroline = FALSE),
      legend = list(title = list(text = color_title), orientation = "v", x = 1.01, y = 1),
      margin = list(l = 70, r = 140, t = 70, b = 70)
    )
