          final_third_rate = round(final_third_rate, 3),
          mean_length = round(mean_length, 1)
        ),
      options = list(pageLength = 15, scrollX = TRUE, autoWidth = FALSE),
      rownames = FALSE,
      class = "stripe hover nowrap",
      width = "100%"
    )
  })
  
  # ---------------- Hold dashboard ----------------
  selected_team_players <- reactive({
    make_player_summary(pass_data, input$team_pick)
  })
  
  selected_team_summary <- reactive({
    team_summary %>% filter(team_name == input$team_pick)
  })
  
  output$h_total_card <- renderUI({
    div(
      class = "kpi-card kpi-purple",
      div(class = "kpi-value", selected_team_summary()$antal_afleveringer),
      div(class = "kpi-label", paste("Samlede afleveringer –", input$team_pick))
    )
  })
  
  output$h_success_card <- renderUI({
    div(
      class = "kpi-card kpi-green",
      div(class = "kpi-value", percent(selected_team_summary()$success_rate, accuracy = 0.1)),
      div(class = "kpi-label", "Succesrate")
    )
  })
  
  output$h_prog_card <- renderUI({
    div(
      class = "kpi-card kpi-blue",
      div(class = "kpi-value", percent(selected_team_summary()$progressive_rate, accuracy = 0.1)),
      div(class = "kpi-label", "Progressive rate")
    )
  })
  
  output$h_len_card <- renderUI({
    div(
      class = "kpi-card kpi-orange",
      div(class = "kpi-value", round(selected_team_summary()$mean_length, 1)),
      div(class = "kpi-label", "Gennemsnitlig afleveringslængde")
    )
  })
  
  output$h_plot <- renderPlotly({
    df <- selected_team_players() %>%
      mutate(
        hover_text = paste0(
          "Spiller: ", passer_name,
          "<br>", nice_axis_label(input$h_x), ": ", round(.data[[input$h_x]], 3),
          "<br>", nice_axis_label(input$h_y), ": ", round(.data[[input$h_y]], 3),
          "<br>Antal afleveringer: ", antal_afleveringer
        )
      )
    
    plot_ly(
      data = df,
      x = as.formula(paste0("~", input$h_x)),
      y = as.formula(paste0("~", input$h_y)),
      type = "scatter",
      mode = "markers",
      text = ~hover_text,
      hoverinfo = "text",
      marker = list(size = 14, color = "#3b82f6", opacity = 0.88)
    ) %>%
      config(
        displaylogo = FALSE,
        modeBarButtonsToRemove = c(
          "zoom2d", "pan2d", "select2d", "lasso2d",
          "zoomIn2d", "zoomOut2d", "autoScale2d",
          "resetScale2d", "toggleSpikelines"
        )
      ) %>%
      layout(
        title = list(text = paste(input$team_pick, "– spillerdashboard"), x = 0.02, xanchor = "left", font = list(size = 18)),
        paper_bgcolor = "rgba(0,0,0,0)",
        plot_bgcolor = "#ffffff",
        xaxis = list(title = nice_axis_label(input$h_x), gridcolor = "#e5e7eb", zeroline = FALSE),
        yaxis = list(title = nice_axis_label(input$h_y), gridcolor = "#e5e7eb", zeroline = FALSE),
        margin = list(l = 70, r = 30, t = 70, b = 70)
      )
  })
  
  output$h_table <- renderDT({
    datatable(
      selected_team_players() %>%
        arrange(desc(antal_afleveringer)) %>%
        mutate(
          success_rate = round(success_rate, 3),
          progressive_rate = round(progressive_rate, 3),
          forward_rate = round(forward_rate, 3),
          final_third_rate = round(final_third_rate, 3),
          mean_length = round(mean_length, 1)
        ),
      options = list(pageLength = 15, scrollX = TRUE, autoWidth = FALSE),
      rownames = FALSE,
      class = "stripe hover nowrap",
      width = "100%"
    )
  })
  
  # ---------------- Hold-tal ----------------
  output$team_data_table <- renderDT({
    datatable(
      make_team_data_table(team_summary),
      options = list(pageLength = 14, scrollX = TRUE, autoWidth = FALSE),
      rownames = FALSE,
      class = "stripe hover nowrap",
      width = "100%"
    ) %>%
      formatRound(columns = "Gns. afleveringslængde", digits = 1) %>%
      formatPercentage(columns = c("Succesrate", "Progressive rate", "Final third rate", "Forward rate"), digits = 1) %>%
      formatRound(columns = "Antal afleveringer", digits = 0)
  })
  
  # ---------------- Spiller-tal ----------------
  output$player_data_table <- renderDT({
    player_table <- make_player_data_table(pass_data, input$player_table_team)
    
    datatable(
      player_table,
      options = list(pageLength = 15, scrollX = TRUE, autoWidth = FALSE),
      rownames = FALSE,
      class = "stripe hover nowrap",
      width = "100%"
    ) %>%
      formatRound(columns = "Gns. afleveringslængde", digits = 1) %>%
      formatPercentage(columns = c("Succesrate", "Progressive rate", "Final third rate", "Forward rate"), digits = 1) %>%
      formatRound(columns = "Antal afleveringer", digits = 0)
  })
  
  # ---------------- Pass map ----------------
  output$pitch_plot <- renderPlotly({
    validate(
      need(requireNamespace("ggsoccer", quietly = TRUE), "Installér pakken 'ggsoccer' for at vise pass map-tabben.")
    )
    validate(
      need(any(!is.na(pass_data$start_x)), "Pass map kræver startkoordinater i passes_df. Tilføj fx STARTLOCATIONX/STARTLOCATIONY eller LOCATIONX/LOCATIONY i dit grunddatasæt.")
    )
    
    pitch_df <- make_pass_map_data(
      pass_data,
      team_selected = input$pitch_team,
      match_selected = input$pitch_match,
      player_selected = input$pitch_player,
      top_n = input$pitch_top_n,
      min_passes = input$pitch_min_passes
    )
    
    validate(
      need(nrow(pitch_df) > 0, "Ingen afleveringsmønstre matcher det valgte filter.")
    )
    
    p <- ggplot(pitch_df) +
      ggsoccer::annotate_pitch(dimensions = ggsoccer::pitch_opta, colour = "#cbd5e1") +
      geom_segment(
        aes(
          x = from_x,
          y = from_y,
          xend = to_x,
          yend = to_y,
          size = antal_afleveringer,
          text = hover_text
        ),
        arrow = arrow(length = grid::unit(0.18, "cm"), type = "closed"),
        colour = "#38bdf8",
        alpha = 0.70,
        lineend = "round"
      ) +
      scale_size(range = c(0.6, 2.8), guide = "none") +
      coord_fixed(xlim = c(0, 100), ylim = c(0, 100), clip = "off") +
      ggsoccer::theme_pitch() +
      theme(
        plot.background = element_rect(fill = "white", colour = NA),
        panel.background = element_rect(fill = "white", colour = NA),
        plot.title = element_text(size = 18, face = "bold", colour = "#1f2937"),
        plot.margin = margin(10, 10, 10, 10)
      ) +
      labs(title = paste("Pass map –", input$pitch_team))
    
    ggplotly(p, tooltip = "text") %>%
      config(
        displaylogo = FALSE,
        modeBarButtonsToRemove = c(
          "zoom2d", "pan2d", "select2d", "lasso2d",
          "zoomIn2d", "zoomOut2d", "autoScale2d",
          "resetScale2d", "toggleSpikelines"
        )
      )
  })
  
  # ---------------- Heatmap ----------------
  output$heat_plot <- renderPlot({
    validate(
      need(requireNamespace("ggsoccer", quietly = TRUE), "Installér pakken 'ggsoccer' for at vise heatmap-tabben.")
    )
    validate(
      need(any(!is.na(pass_data$start_x)), "Heatmap kræver koordinater i passes_df.")
    )
    
    heat_df <- make_heatmap_data(
      pass_data,
      team_selected = input$heat_team,
      match_selected = input$heat_match,
      player_selected = input$heat_player,
      mode = input$heat_mode
    )
    
    plot_pitch_heatmap(heat_df, paste("Heatmap –", input$heat_team))
  })
  
  # ---------------- Kamp-sammenligning ----------------
  output$cmp_plot1 <- renderPlot({
    validate(
      need(requireNamespace("ggsoccer", quietly = TRUE), "Installér pakken 'ggsoccer' for at vise kamp-sammenligning.")
    )
    req(input$cmp_team, input$cmp_match1)
    
    cmp1_df <- make_heatmap_data(
      pass_data,
      team_selected = input$cmp_team,
      match_selected = input$cmp_match1,
      player_selected = input$cmp_player,
      mode = input$cmp_heat_mode
    )
    
    plot_pitch_heatmap(cmp1_df, input$cmp_match1)
  })
  
  output$cmp_plot2 <- renderPlot({
    validate(
      need(requireNamespace("ggsoccer", quietly = TRUE), "Installér pakken 'ggsoccer' for at vise kamp-sammenligning.")
    )
    req(input$cmp_team, input$cmp_match2)
    
    cmp2_df <- make_heatmap_data(
      pass_data,
      team_selected = input$cmp_team,
      match_selected = input$cmp_match2,
      player_selected = input$cmp_player,
      mode = input$cmp_heat_mode
    )
    
    plot_pitch_heatmap(cmp2_df, input$cmp_match2)
  })
  
  output$cmp_table1 <- renderDT({
    req(input$cmp_team, input$cmp_match1)
    
    tbl1 <- make_match_summary(
      pass_data,
      team_selected = input$cmp_team,
      match_selected = input$cmp_match1,
      player_selected = input$cmp_player
    )
    
    datatable(
      tbl1,
      options = list(dom = "t", scrollX = TRUE, autoWidth = FALSE),
      rownames = FALSE,
      class = "stripe hover nowrap",
      width = "100%"
    ) %>%
      formatRound(columns = "Gns. afleveringslængde", digits = 1) %>%
      formatPercentage(columns = c("Succesrate", "Progressive rate", "Final third rate", "Forward rate"), digits = 1)
  })
  
  output$cmp_table2 <- renderDT({
    req(input$cmp_team, input$cmp_match2)
    
    tbl2 <- make_match_summary(
      pass_data,
      team_selected = input$cmp_team,
      match_selected = input$cmp_match2,
      player_selected = input$cmp_player
    )
    
    datatable(
      tbl2,
      options = list(dom = "t", scrollX = TRUE, autoWidth = FALSE),
      rownames = FALSE,
      class = "stripe hover nowrap",
      width = "100%"
    ) %>%
      formatRound(columns = "Gns. afleveringslængde", digits = 1) %>%
      formatPercentage(columns = c("Succesrate", "Progressive rate", "Final third rate", "Forward rate"), digits = 1)
  })
  
  # ---------------------------------------------------------
  # KAMPE - CLUSTERING APP
  # ---------------------------------------------------------
  plot_data <- reactive({
    advanced_stats %>%
      filter(
        !is.na(.data[[input$xvar]]),
        !is.na(.data[[input$yvar]]),
        !is.na(cluster2)
      )
  })
  
  output$cluster_plot <- renderPlotly({
    df <- plot_data() %>%
      left_join(cluster_navne, by = "cluster2")
    
    kamp <- ggplot(
      df,
      aes(
        x = .data[[input$xvar]],
        y = .data[[input$yvar]],
        color = as.factor(cluster2),
        text = paste(
          "Match ID:", MATCH_WYID,
          "<br>Hold:", team_name,
          "<br>Modstander:", OPPONENT_TEAMNAME,
          "<br>Cluster:", cluster2,
          "<br>Cluster-navn:", cluster_navn,
          "<br>", input$xvar, ":", round(.data[[input$xvar]], 3),
          "<br>", input$yvar, ":", round(.data[[input$yvar]], 3),
          "<br>xG pr. skud:", round(XGPERSHOT, 3),
          "<br>xG:", round(XG, 3),
          "<br>Gns. skudafstand:", round(AVGDISTANCE, 2)
        )
      )
    ) +
      geom_point(size = 2) +
      labs(
        title = "Clustering af kampe",
        x = input$xvar,
        y = input$yvar,
        color = "Cluster"
      ) +
      theme_minimal()
    
    ggplotly(kamp, tooltip = "text")
  })
  
  output$cluster_summary_tabel <- renderTable({
    advanced_stats %>%
      group_by(cluster2) %>%
      summarise(
        shots = round(mean(SHOTS, na.rm = TRUE), 2),
        xg = round(mean(XG, na.rm = TRUE), 2),
        goals = round(mean(GOALS, na.rm = TRUE), 2),
        touches_box = round(mean(TOUCHESINBOX, na.rm = TRUE), 2),
        prog_runs = round(mean(PROGRESSIVERUNS, na.rm = TRUE), 2),
        .groups = "drop"
      ) %>%
      left_join(cluster_navne, by = "cluster2") %>%
      select(
        cluster = cluster2,
        cluster_navn,
        shots,
        xg,
        goals,
        touches_box,
        prog_runs
      )
  })
}

shinyApp(ui, server)
