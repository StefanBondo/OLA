prepare_pass_data <- function(df) {
  start_x <- if ("STARTLOCATIONX" %in% names(df)) {
    as.numeric(df$STARTLOCATIONX)
  } else if ("LOCATIONX" %in% names(df)) {
    as.numeric(df$LOCATIONX)
  } else {
    rep(NA_real_, nrow(df))
  }
  
  start_y <- if ("STARTLOCATIONY" %in% names(df)) {
    as.numeric(df$STARTLOCATIONY)
  } else if ("LOCATIONY" %in% names(df)) {
    as.numeric(df$LOCATIONY)
  } else {
    rep(NA_real_, nrow(df))
  }
  
  end_x <- if ("ENDLOCATIONX" %in% names(df)) {
    as.numeric(df$ENDLOCATIONX)
  } else {
    rep(NA_real_, nrow(df))
  }
  
  end_y <- if ("ENDLOCATIONY" %in% names(df)) {
    as.numeric(df$ENDLOCATIONY)
  } else {
    rep(NA_real_, nrow(df))
  }
  
  match_id <- if ("MATCH_WYID" %in% names(df)) {
    as.character(df$MATCH_WYID)
  } else if ("match_wyid" %in% names(df)) {
    as.character(df$match_wyid)
  } else if ("MATCHID" %in% names(df)) {
    as.character(df$MATCHID)
  } else if ("match_id" %in% names(df)) {
    as.character(df$match_id)
  } else {
    as.character(seq_len(nrow(df)))
  }
  
  match_label <- if ("MATCHLABEL" %in% names(df)) {
    as.character(df$MATCHLABEL)
  } else if ("match_label" %in% names(df)) {
    as.character(df$match_label)
  } else {
    rep(NA_character_, nrow(df))
  }
  
  match_date <- if ("DATEUTC" %in% names(df)) {
    as.character(df$DATEUTC)
  } else if ("MATCH_DATE" %in% names(df)) {
    as.character(df$MATCH_DATE)
  } else if ("match_date" %in% names(df)) {
    as.character(df$match_date)
  } else if ("date" %in% names(df)) {
    as.character(df$date)
  } else {
    rep(NA_character_, nrow(df))
  }
  
  if (all(is.na(match_label) | match_label == "")) {
    match_label <- ifelse(
      !is.na(match_date) & match_date != "",
      paste("Kamp", match_id, "-", match_date),
      paste("Kamp", match_id)
    )
  }
  
  df %>%
    mutate(
      start_x = start_x,
      start_y = start_y,
      ENDLOCATIONX = end_x,
      ENDLOCATIONY = end_y,
      LENGTH = as.numeric(LENGTH),
      match_id = match_id,
      match_label = match_label,
      match_date = match_date,
      successful_pass = if_else(
        if_any(starts_with("SECONDARYTYPE"), ~ coalesce(as.character(.x), "") == "loss"),
        0, 1
      ),
      progressive_flag = if_else(
        if_any(starts_with("SECONDARYTYPE"), ~ coalesce(as.character(.x), "") == "progressive_pass"),
        1, 0
      ),
      final_third_flag = if_else(
        if_any(starts_with("SECONDARYTYPE"), ~ coalesce(as.character(.x), "") == "pass_to_final_third"),
        1, 0
      ),
      forward_flag = if_else(
        if_any(starts_with("SECONDARYTYPE"), ~ coalesce(as.character(.x), "") == "forward_pass"),
        1, 0
      )
    ) %>%
    filter(!is.na(team_name))
}

