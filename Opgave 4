make_team_summary <- function(df) {
  df %>%
    filter(!is.na(LENGTH)) %>%
    group_by(team_name) %>%
    summarise(
      mean_length = mean(LENGTH, na.rm = TRUE),
      success_rate = mean(successful_pass, na.rm = TRUE),
      progressive_rate = mean(progressive_flag, na.rm = TRUE),
      final_third_rate = mean(final_third_flag, na.rm = TRUE),
      forward_rate = mean(forward_flag, na.rm = TRUE),
      antal_afleveringer = n(),
      .groups = "drop"
    ) %>%
    filter(if_all(c(mean_length, success_rate, progressive_rate, final_third_rate, forward_rate), is.finite))
}

make_player_summary <- function(df, team_selected = "Brøndby IF") {
  base_df <- df %>%
    filter(!is.na(passer_name), passer_wyid != 0) %>%
    filter(!is.na(LENGTH))
  
  if (!identical(team_selected, "Alle")) {
    base_df <- base_df %>% filter(team_name == team_selected)
    
    base_df %>%
      group_by(passer_name) %>%
      summarise(
        mean_length = mean(LENGTH, na.rm = TRUE),
        success_rate = mean(successful_pass, na.rm = TRUE),
        progressive_rate = mean(progressive_flag, na.rm = TRUE),
        final_third_rate = mean(final_third_flag, na.rm = TRUE),
        forward_rate = mean(forward_flag, na.rm = TRUE),
        antal_afleveringer = n(),
        .groups = "drop"
      ) %>%
      filter(if_all(c(mean_length, success_rate, progressive_rate, final_third_rate, forward_rate), is.finite))
  } else {
    base_df %>%
      group_by(team_name, passer_name) %>%
      summarise(
        mean_length = mean(LENGTH, na.rm = TRUE),
        success_rate = mean(successful_pass, na.rm = TRUE),
        progressive_rate = mean(progressive_flag, na.rm = TRUE),
        final_third_rate = mean(final_third_flag, na.rm = TRUE),
        forward_rate = mean(forward_flag, na.rm = TRUE),
        antal_afleveringer = n(),
        .groups = "drop"
      ) %>%
      filter(if_all(c(mean_length, success_rate, progressive_rate, final_third_rate, forward_rate), is.finite))
  }
}

