make_pass_map_data <- function(df, team_selected, match_selected = "Alle", player_selected = "Alle", top_n = 40, min_passes = 3) {
  out <- df %>%
    filter(
      team_name == team_selected,
      !is.na(start_x),
      !is.na(start_y),
      !is.na(ENDLOCATIONX),
      !is.na(ENDLOCATIONY),
      !is.na(passer_name),
      passer_wyid != 0
    )
  
  if (!identical(match_selected, "Alle")) {
    out <- out %>% filter(match_label == match_selected)
  }
  
  if (!identical(player_selected, "Alle")) {
    out <- out %>% filter(passer_name == player_selected)
  }
  
  out %>%
    mutate(
      from_x = round(start_x / 10) * 10,
      from_y = round(start_y / 10) * 10,
      to_x   = round(ENDLOCATIONX / 10) * 10,
      to_y   = round(ENDLOCATIONY / 10) * 10
    ) %>%
    group_by(passer_name, from_x, from_y, to_x, to_y) %>%
    summarise(
      antal_afleveringer = n(),
      success_rate = mean(successful_pass, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    filter(antal_afleveringer >= min_passes) %>%
    arrange(desc(antal_afleveringer)) %>%
    slice_head(n = top_n) %>%
    mutate(
      hover_text = paste0(
        "Spiller: ", passer_name,
        "<br>Fra: (", from_x, ", ", from_y, ")",
        "<br>Til: (", to_x, ", ", to_y, ")",
        "<br>Antal afleveringer: ", antal_afleveringer,
        "<br>Succesrate: ", percent(success_rate, accuracy = 0.1)
      )
    )
}

make_heatmap_data <- function(df, team_selected, match_selected = "Alle", player_selected = "Alle", mode = "start") {
  out <- df %>% filter(team_name == team_selected)
  
  if (!identical(match_selected, "Alle")) {
    out <- out %>% filter(match_label == match_selected)
  }
  
  if (!identical(player_selected, "Alle")) {
    out <- out %>% filter(passer_name == player_selected)
  }
  
  if (mode == "start") {
    out %>%
      filter(!is.na(start_x), !is.na(start_y)) %>%
      transmute(x = start_x, y = start_y)
  } else {
    out %>%
      filter(!is.na(ENDLOCATIONX), !is.na(ENDLOCATIONY)) %>%
      transmute(x = ENDLOCATIONX, y = ENDLOCATIONY)
  }
}

make_match_summary <- function(df, team_selected, match_selected, player_selected = "Alle") {
  out <- df %>% filter(team_name == team_selected)
  
  if (!identical(match_selected, "Alle")) {
    out <- out %>% filter(match_label == match_selected)
  }
  
  if (!identical(player_selected, "Alle")) {
    out <- out %>% filter(passer_name == player_selected)
  }
  
  out %>%
    summarise(
      `Antal afleveringer` = n(),
      Succesrate = mean(successful_pass, na.rm = TRUE),
      `Gns. afleveringslængde` = mean(LENGTH, na.rm = TRUE),
      `Progressive rate` = mean(progressive_flag, na.rm = TRUE),
      `Final third rate` = mean(final_third_flag, na.rm = TRUE),
      `Forward rate` = mean(forward_flag, na.rm = TRUE)
    )
}

plot_pitch_heatmap <- function(df_plot, title_text) {
  validate(
    need(nrow(df_plot) > 0, "Ingen data matcher det valgte filter.")
  )
  
  ggplot(df_plot, aes(x = x, y = y)) +
    ggsoccer::annotate_pitch(dimensions = ggsoccer::pitch_opta, colour = "#cbd5e1") +
    stat_bin_2d(bins = 12, aes(fill = after_stat(count)), alpha = 0.85) +
    scale_fill_gradient(low = "#dbeafe", high = "#1d4ed8", guide = "none") +
    coord_fixed(xlim = c(0, 100), ylim = c(0, 100), clip = "off") +
    ggsoccer::theme_pitch() +
    theme(
      plot.background = element_rect(fill = "white", colour = NA),
      panel.background = element_rect(fill = "white", colour = NA),
      plot.title = element_text(size = 18, face = "bold", colour = "#1f2937"),
      plot.margin = margin(10, 10, 10, 10)
    ) +
    labs(title = title_text)
}

nice_axis_label <- function(x) {
  case_when(
    x == "mean_length" ~ "Gennemsnitlig længde",
    x == "success_rate" ~ "Succesrate",
    x == "progressive_rate" ~ "Progressive rate",
    x == "forward_rate" ~ "Forward rate",
    x == "final_third_rate" ~ "Final third rate",
    TRUE ~ x
  )
}

make_hover_text <- function(df, entity = c("team", "player"), x_var, y_var) {
  entity <- match.arg(entity)
  name_col <- if (entity == "team") "team_name" else "passer_name"
  label <- if (entity == "team") "Hold" else "Spiller"
  x_lab <- nice_axis_label(x_var)
  y_lab <- nice_axis_label(y_var)
  
  df %>%
    mutate(
      hover_text = paste0(
        label, ": ", .data[[name_col]],
        "<br>", x_lab, ": ", round(.data[[x_var]], 3),
        "<br>", y_lab, ": ", round(.data[[y_var]], 3),
        "<br>Antal afleveringer: ", antal_afleveringer
      )
    )
}

plot_cluster_scatter <- function(df, x_var, y_var, title, color_title) {
  plot_ly(
    data = df,
    x = as.formula(paste0("~", x_var)),
    y = as.formula(paste0("~", y_var)),
    type = "scatter",
    mode = "markers",
    color = ~cluster_name,
    text = ~hover_text,
    hoverinfo = "text",
    marker = list(size = 13, opacity = 0.9, line = list(width = 0))
  ) %>%
    config(
      displaylogo = FALSE,
      modeBarButtonsToRemove = c(
        "zoom2d", "pan2d", "select2d", "lasso2d",
        "zoomIn2d", "zoomOut2d", "autoScale2d",
        "resetScale2d", "toggleSpikelines"
      )
