#1)	Den gennemsnitlige længde på afleveringerne #-------------#-------------#-------------#-------------#-------------

gennemsnits_længde_aflevering <- passes_superliga %>% 
  filter(!is.na(LENGTH)) %>% 
  group_by(team_name) %>% 
  summarise(
    gennemsnits_længde = round(mean(LENGTH, na.rm = TRUE), 2),
  ) %>% 
  arrange(desc(gennemsnits_længde))


ggplot(gennemsnits_længde_aflevering, 
       aes(x = gennemsnits_længde, 
           y = reorder(team_name, gennemsnits_længde),
           fill = team_name)) +
  geom_col() +
  labs(
    x = "Gennemsnitlig afleveringslængde",
    y = "Hold",
    title = "Lyngby har i gns. de længeste afleveringer",
    caption = "Kilde: Wyscout med egne beregninger"
  ) +
  guides(fill = "none")

####-------------#-------------#-------------#-------------#-------------#-------------#-------------#-------------#-------------

#2) Andel af afleveringer, der rammer en medspiller og den gennemsnitlige længde

passes_superliga <- passes_superliga %>% 
  mutate(
    pass_succes = case_when(
      SECONDARYTYPE1 == "loss" ~ "unsuccessful",
      SECONDARYTYPE2 == "loss" ~ "unsuccessful",
      SECONDARYTYPE3 == "loss" ~ "unsuccessful",
      TRUE ~ "successful"
    )
  )

gennemsnits_længde_og_andel_som_rammer <- passes_superliga %>% 
  filter(!is.na(team_name)) %>% 
  filter(pass_succes == "successful") %>% 
  group_by(team_name) %>% 
  summarise(succesful_afleveringer = n(),
            gennemsnits_længde = round(mean(LENGTH, na.rm = TRUE), 2)) %>% 
  arrange(desc(succesful_afleveringer))


ggplot(gennemsnits_længde_og_andel_som_rammer,
       aes(x = gennemsnits_længde,
           y = reorder(team_name, gennemsnits_længde),
           fill = team_name)) +
  geom_col() +
  labs(
    x = "Gennemsnitlig længde (succesfulde afleveringer)",
    y = "Hold",
    title = "Lynby har i gns de længeste succesfulde afleveringer",
    caption = "Kilde: Wyscout - Egne beregninger"
  ) +
  guides(fill = "none")

