#5) Top 10 spiller med flest succesfulde afleveringer

top_10_afleveringer <- passes_superliga %>% 
  filter(pass_succes == "successful") %>% 
  group_by(passer_name, team_name, pass_succes) %>% 
  summarise(antal = n(), .groups = "drop") %>% 
  group_by(passer_name) %>% 
  ungroup() %>% 
  arrange(desc(antal)) %>% 
  slice(1:10)


ggplot(top_10_afleveringer,
       aes(x = antal,
           y = reorder(passer_name, antal),
           fill = passer_name)) +
  geom_col() +
  labs(
    x = "Antal succesfulde afleveringer",
    y = "Spiller",
    title = "Wessel Dammers fra Randers er den spiller med flest succesfulde afleveringer",
    caption = "Kilde: Wyscout - Egne beregninger (24/25)"
  ) +
  guides(fill = "none")

