#8) Falder antallet succes afleveringer gennem tiden


passes_superliga <- passes_superliga %>% 
  mutate(
    interval = case_when(
      MINUTE >= 0  & MINUTE <= 15 ~ "0–15",
      MINUTE >= 16 & MINUTE <= 30 ~ "16–30",
      MINUTE >= 31 & MINUTE <= 45 ~ "31–45",
      MINUTE >= 46 & MINUTE <= 60 ~ "46–60",
      MINUTE >= 61 & MINUTE <= 75 ~ "61–75",
      MINUTE >= 76 & MINUTE <= 90 ~ "76–90",
      TRUE ~ NA_character_
    )
  )

succesfulde_afleveringer_gennem_tid <- passes_superliga %>% 
  filter(!is.na(interval)) %>% 
  group_by(team_name, interval) %>% 
  summarise(alle_skud = n(), .groups = "drop",
            success_antal = sum(pass_succes == "successful"),
            success_rate = round(mean(pass_succes == "successful") * 100, 2)) %>% 
  group_by(team_name) %>% 
  ungroup()

