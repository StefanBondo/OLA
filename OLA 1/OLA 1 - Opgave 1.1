#3)	Den position på banen, der modtager flest aflevering

afleveringer_per_postion <- passes_superliga %>% 
  filter(pass_succes == "successful",
         !is.na(recipient_position)) %>% 
  group_by(recipient_position) %>% 
  summarise(succesful_afleveringer = n()) %>% 
  arrange(desc(succesful_afleveringer))

ggplot(afleveringer_per_postion,
       aes(x = succesful_afleveringer,
           y = reorder(recipient_position, succesful_afleveringer),
           fill = recipient_position)) +
  geom_col() +
  labs(
    x = "Den position på banen, der modtager flest aflevering",
    y = "Position",
    title = "Left Center Back er den position 
som modtager flest afleveringer i ligaen",
    caption = "Kilde: Wyscout - Egne beregninger (24/25)"
  ) +
  guides(fill = "none")

###-------------#-------------#-------------#-------------#-------------#-------------#-------------#-------------#-------------

#4) Er lange afleveringer mere risikable end korte?
  
passes_superliga <- passes_superliga %>% 
  mutate(
    lang_eller_kort = case_when(
      LENGTH < 20 ~ "kort",
      LENGTH >= 20 & LENGTH <= 30 ~ "Mellem",
      LENGTH > 30 ~ "Lang",
      TRUE ~ NA_character_
    )
  )

lang_eller_kort_succes <- passes_superliga %>% 
  filter(!is.na(team_name),
         !is.na(lang_eller_kort)) %>% 
  group_by(lang_eller_kort, team_name) %>% 
  summarise(
    alle_afleveringer = n(),
    success_antal = sum(pass_succes == "successful"),
    unsuccess_antal = sum(pass_succes == "unsuccessful"),
    success_rate = round(mean(pass_succes == "successful") * 100, 2),
    unsuccess_rate = round(mean(pass_succes == "unsuccessful") * 100, 2),
    .groups = "drop"
  )



ggplot(lang_eller_kort_succes,
       aes(x = team_name,
           y = success_rate,
           fill = lang_eller_kort)) +
  geom_col(position = "dodge") +
  labs(
    x = "Hold",
    y = "Succesrate (%)",
    title = "Korte og mellem afleveringer har højere succesrate",
    caption = "Kilde Wyscout - Egne beregninger",
    fill = "Afleveringstype"
  ) +
  coord_flip()

