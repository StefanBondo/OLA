# ------------------------------------------------------------
# PARAMETRE
# ------------------------------------------------------------
comp_id <- 335
date_from <- as.Date("2024-07-01")
date_to <- Sys.Date()

# ------------------------------------------------------------
# 1) Matches (grundtabel)
# ------------------------------------------------------------
matches_335 <- dbGetQuery(con, glue("
  SELECT
    MATCH_WYID,
    DATE       AS match_date,
    MATCHLABEL AS match_label
  FROM wyscout_matches
  WHERE COMPETITION_WYID = {comp_id}
")) %>%
  mutate(match_date = as.Date(match_date)) %>%
  distinct(MATCH_WYID, .keep_all = TRUE) %>%
  filter(match_date >= date_from,
         match_date <= date_to)

# ------------------------------------------------------------
# 2) Passes fra COMMON (MASTER)  ✅ SKAL være 281.866
# ------------------------------------------------------------
passes_common <- dbGetQuery(con, glue("
  SELECT
    p.EVENT_WYID,
    p.MATCH_WYID,
    p.MATCHPERIOD,
    p.MINUTE,
    p.SECOND,
    p.TEAM_WYID,
    p.PLAYER_WYID,
    p.LOCATIONX,
    p.LOCATIONY
  FROM wyscout_matchevents_common p
  LEFT JOIN wyscout_matches m
    ON p.MATCH_WYID = m.MATCH_WYID
  WHERE p.COMPETITION_WYID = {comp_id}
    AND p.PRIMARYTYPE = 'pass'
    AND m.DATE >= '{format(date_from, '%Y-%m-%d')}'
    AND m.DATE <= CURDATE()
"))

stopifnot(nrow(passes_common) == 281866)

# ------------------------------------------------------------
# 3) Pass numeriske felter (LENGTH, ANGLE, HEIGHT) + recipient
#    (hentes UDEN IN-liste)
# ------------------------------------------------------------
passes_numbers <- dbGetQuery(con, glue("
  SELECT
    p.EVENT_WYID,
    p.RECIPIENT_WYID,
    p.LENGTH,
    p.ANGLE,
    p.HEIGHT,
    p.ACCURATE,
    p.ENDLOCATIONX,
    p.ENDLOCATIONY
  FROM wyscout_matchevents_passes p
  LEFT JOIN wyscout_matches m
    ON p.MATCH_WYID = m.MATCH_WYID
  WHERE p.COMPETITION_WYID = {comp_id}
    AND p.PRIMARYTYPE = 'pass'
    AND m.DATE >= '{format(date_from, '%Y-%m-%d')}'
    AND m.DATE <= CURDATE()
")) %>%
  group_by(EVENT_WYID) %>%            # sikrer 1 række pr event
  slice(1) %>%
  ungroup()

# ------------------------------------------------------------
# 4) Secondary types (hentes UDEN IN-liste)
# ------------------------------------------------------------
secondary <- dbGetQuery(con, glue("
  SELECT
    s.EVENT_WYID,
    s.PRIMARYTYPE AS secondary_primarytype,
    s.SECONDARYTYPE1,
    s.SECONDARYTYPE2,
    s.SECONDARYTYPE3,
    s.SECONDARYTYPE4,
    s.SECONDARYTYPE5,
    s.SECONDARYTYPE6,
    s.SECONDARYTYPE7
  FROM wyscout_matchevents_secondarytype s
  LEFT JOIN wyscout_matches m
    ON s.MATCH_WYID = m.MATCH_WYID
  WHERE s.COMPETITION_WYID = {comp_id}
    AND m.DATE >= '{format(date_from, '%Y-%m-%d')}'
    AND m.DATE <= CURDATE()
")) %>%
  group_by(EVENT_WYID) %>%
  slice(1) %>%
  ungroup()

# ------------------------------------------------------------
# 5) Teams
# ------------------------------------------------------------
teams <- dbGetQuery(con, "
  SELECT
    TEAM_WYID,
    TEAMNAME AS team_name
  FROM wyscout_teams
") %>%
  distinct(TEAM_WYID, .keep_all = TRUE)

# ------------------------------------------------------------
# 6) Players
# ------------------------------------------------------------
players <- dbGetQuery(con, "
  SELECT
    PLAYER_WYID,
    CONCAT(FIRSTNAME, ' ', LASTNAME) AS player_name
  FROM wyscout_players
") %>%
  distinct(PLAYER_WYID, .keep_all = TRUE)

# ------------------------------------------------------------
# 7) Saml det hele (skal stadig være 281.866) ✅
# ------------------------------------------------------------
passes_df <- matches_335 %>%
  left_join(passes_common, by = "MATCH_WYID") %>%
  left_join(passes_numbers, by = "EVENT_WYID") %>%
  left_join(secondary, by = "EVENT_WYID") %>%
  left_join(teams, by = "TEAM_WYID") %>%
  left_join(players %>% rename(passer_name = player_name),
            by = c("PLAYER_WYID" = "PLAYER_WYID")) %>%
  left_join(players %>% rename(recipient_name = player_name),
            by = c("RECIPIENT_WYID" = "PLAYER_WYID"))

stopifnot(nrow(passes_df) == 281866)

passes_df <- passes_df %>%
  mutate(PRIMARYTYPE = "pass")

table(passes_df$PRIMARYTYPE)

