corner_to_pass <- dbGetQuery(con, glue::glue("
  SELECT
    COUNT(*) AS total_corners,
    SUM(CASE WHEN p.EVENT_WYID IS NOT NULL THEN 1 ELSE 0 END) AS corners_with_pass,
    ROUND(
      SUM(CASE WHEN p.EVENT_WYID IS NOT NULL THEN 1 ELSE 0 END) 
      / COUNT(*) * 100, 
      2
    ) AS pct_corners_with_pass
  FROM wyscout_matchevents_common c
  
  LEFT JOIN wyscout_matchevents_passes p
    ON c.EVENT_WYID = p.EVENT_WYID
  
  LEFT JOIN wyscout_matches m
    ON c.MATCH_WYID = m.MATCH_WYID
  
  WHERE c.COMPETITION_WYID = {comp_id}
    AND c.PRIMARYTYPE = 'corner'
    AND m.DATE >= '{format(date_from, '%Y-%m-%d')}'
    AND m.DATE <= CURDATE()
"))

corner_to_pass

