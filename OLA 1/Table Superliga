comp_id <- 335
date_from <- as.Date("2024-07-01")
# (valgfri) date_to kan sættes hvis du vil: Sys.Date() eller en fast dato
date_to <- Sys.Date()

# ------------------------------------------------------------
# 1) Matches (grundtabel)  ✅ herfra bygger vi alt
# ------------------------------------------------------------
matches_335 <- dbGetQuery(con, glue::glue("
  SELECT
    MATCH_WYID,
    DATE       AS match_date,
    MATCHLABEL AS match_label
  FROM wyscout_matches
  WHERE COMPETITION_WYID = {comp_id}
")) %>%
  mutate(match_date = as.Date(match_date)) %>%
  distinct(MATCH_WYID, .keep_all = TRUE) %>%
  filter(match_date >= date_from, match_date <= date_to)

# ------------------------------------------------------------
# 2) Passes (kun base)  (kun pass-events, samme som før)
# ------------------------------------------------------------
passes_base <- dbGetQuery(con, glue::glue("
  SELECT
    EVENT_WYID,
    MATCH_WYID,
    COMPETITION_WYID,
    PRIMARYTYPE,
    ACCURATE,
    ANGLE,
    HEIGHT,
    LENGTH,
    RECIPIENT_WYID,
    ENDLOCATIONX,
    ENDLOCATIONY
  FROM wyscout_matchevents_passes
  WHERE COMPETITION_WYID = {comp_id}
    AND PRIMARYTYPE = 'pass'
")) %>%
  distinct(EVENT_WYID, .keep_all = TRUE)

# ------------------------------------------------------------
# 3) Common events (tid + hold + passer)
# ------------------------------------------------------------
events_common <- dbGetQuery(con, "
  SELECT
    EVENT_WYID,
    MATCHPERIOD,
    MINUTE,
    SECOND,
    TEAM_WYID,
    PLAYER_WYID AS passer_wyid
  FROM wyscout_matchevents_common
") %>%
  distinct(EVENT_WYID, .keep_all = TRUE)

# ------------------------------------------------------------
# 4) Teams
# ------------------------------------------------------------
teams <- dbGetQuery(con, "
  SELECT
    TEAM_WYID,
    TEAMNAME AS team_name
  FROM wyscout_teams
") %>%
  distinct(TEAM_WYID, .keep_all = TRUE)

# ------------------------------------------------------------
# 5) Players (navne)
# ------------------------------------------------------------
players <- dbGetQuery(con, "
  SELECT
    PLAYER_WYID,
    CONCAT(FIRSTNAME, ' ', LASTNAME) AS player_name
  FROM wyscout_players
") %>%
  distinct(PLAYER_WYID, .keep_all = TRUE)

# ------------------------------------------------------------
# 6) Secondary types
# ------------------------------------------------------------
secondary <- dbGetQuery(con, "
  SELECT
    EVENT_WYID,
    PRIMARYTYPE AS secondary_primarytype,
    SECONDARYTYPE1,
    SECONDARYTYPE2,
    SECONDARYTYPE3,
    SECONDARYTYPE4,
    SECONDARYTYPE5,
    SECONDARYTYPE6,
    SECONDARYTYPE7
  FROM wyscout_matchevents_secondarytype
") %>%
  distinct(EVENT_WYID, .keep_all = TRUE)

# ------------------------------------------------------------
# 7) Formations (position)
# ------------------------------------------------------------
formations <- dbGetQuery(con, glue::glue("
  SELECT
    MATCH_WYID,
    PLAYER_WYID,
    PLAYERPOSITION
  FROM wyscout_matchformations
  WHERE COMPETITION_WYID = {comp_id}
")) %>%
  distinct(MATCH_WYID, PLAYER_WYID, .keep_all = TRUE)

# ------------------------------------------------------------
# 😎 Saml det hele i R
#   ✅ START FRA MATCHES for at få alle kampe med
# ------------------------------------------------------------
passes_df_all <- matches_335 %>%
  # beholder alle kampe i perioden (også de 2 uden pass-data)
  left_join(passes_base, by = "MATCH_WYID") %>%
  left_join(events_common, by = "EVENT_WYID") %>%
  left_join(teams, by = "TEAM_WYID") %>%
  
  # passer navn
  left_join(
    players %>% select(PLAYER_WYID, passer_name = player_name),
    by = c("passer_wyid" = "PLAYER_WYID")
  ) %>%
  
  # recipient navn
  left_join(
    players %>% select(PLAYER_WYID, recipient_name = player_name),
    by = c("RECIPIENT_WYID" = "PLAYER_WYID")
  ) %>%
  
  # passer position
  left_join(
    formations %>% select(MATCH_WYID, PLAYER_WYID, passer_position = PLAYERPOSITION),
    by = c("MATCH_WYID", "passer_wyid" = "PLAYER_WYID")
  ) %>%
  
  # recipient position
  left_join(
    formations %>% select(MATCH_WYID, PLAYER_WYID, recipient_position = PLAYERPOSITION),
    by = c("MATCH_WYID", "RECIPIENT_WYID" = "PLAYER_WYID")
  ) %>%
  
  left_join(secondary, by = "EVENT_WYID")

passes_superliga <- passes_df_all %>%
  filter(
    match_date >= as.Date("2024-07-01"))


n_distinct(passes_superliga$MATCH_WYID)

