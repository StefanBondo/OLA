superliga <- shots_df_all_superliga %>% 
  mutate(liga = "Superliga")

division1 <- shots_df_all_1division %>% 
  mutate(liga = "1. division")

shots_all <- bind_rows(superliga, division1)
table(shots_all$PRIMARYTYPE)
n_distinct(shots_all$MATCH_WYID)

write_xlsx(shots_all,"shots_all.xlsx")


library(shiny)
library(dplyr)
library(tidyr)
library(ggplot2)

ui <- fluidPage(
  titlePanel("Skud: Mål og xG pr. spiller"),
  
  sidebarLayout(
    sidebarPanel(
      sliderInput(
        inputId = "top_n",
        label   = "Antal spillere (Top N):",
        min     = 5,
        max     = 50,
        value   = 10,
        step    = 1
      )
    ),
    
    mainPanel(
      plotOutput("barplot_goals_xg", height = "500px")
    )
  )
)

server <- function(input, output, session) {
  
  player_summary <- reactive({
    shots_all %>%
      filter(!is.na(player_name), !is.na(SHOTXG)) %>%
      group_by(player_name) %>%
      summarise(
        goals = sum(SHOTISGOAL == 1, na.rm = TRUE),
        xg_sum = sum(SHOTXG, na.rm = TRUE),
        .groups = "drop"
      ) %>%
      arrange(desc(goals), desc(xg_sum)) %>%
      slice_head(n = input$top_n)
  })
  
  output$barplot_goals_xg <- renderPlot({
    
    plot_data <- player_summary() %>%
      pivot_longer(
        cols = c(goals, xg_sum),
        names_to = "metric",
        values_to = "value"
      )
    
    ggplot(plot_data, aes(x = reorder(player_name, value), y = value, fill = metric)) +
      geom_col(position = "dodge") +
      coord_flip() +
      labs(x = "Spiller", y = "Værdi", fill = "") +
      scale_fill_discrete(labels = c(goals = "Mål", xg_sum = "xG-sum"))
  })
}

shinyApp(ui, server)
