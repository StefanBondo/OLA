goal_opening_angle_deg <- function(x, y, goal_width = 7.50,
                                   goal_x = 100, goal_y = 50) {
  # stolpernes y-koordinater på samme skala som y (0-100)
  left_post_y  <- goal_y - goal_width / 2
  right_post_y <- goal_y + goal_width / 2
  
  a1 <- atan2(right_post_y - y, goal_x - x)
  a2 <- atan2(left_post_y  - y, goal_x - x)
  
  abs(a1 - a2) * 180 / pi
}

