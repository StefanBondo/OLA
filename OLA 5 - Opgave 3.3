# afkast og soliditet
afkast_plotdata$variable <- "Afkastningsgrad"
sol_plotdata$variable <- "Soliditetsgrad"

# Saml data i ét datasæt
combined_data <- bind_rows(
  afkast_plotdata %>%
    rename(value = mean_afkast),
  sol_plotdata %>%
    rename(value = mean_sol)
)

# Bestil rækkefølge på grupper og variabler
combined_data$variable <- factor(combined_data$variable,
                                 levels = c("Afkastningsgrad", "Soliditetsgrad"))

combined_data$vurdering_gruppe <- factor(combined_data$vurdering_gruppe,
                                         levels = c(
                                           "Negative = Dårlige / Meget dårlige",
                                           "Neutrale",
                                           "Positive = Gode / Meget gode"
                                         ))


ggplot(combined_data,
       aes(x = variable, y = value, fill = vurdering_gruppe)) +
  geom_col(position = position_dodge(width = 0.7), width = 0.6) +
  
  scale_fill_manual(
    values = c(
      "Negative = Dårlige / Meget dårlige" = "grey70",
      "Neutrale"                           = "grey30",
      "Positive = Gode / Meget gode"       = "#0099E6"
    )
  ) +
  
  labs(
    title   = "Soliditet betyder mere end afkast for synet på muligheden til lån",
    x       = "",
    y       = "Pct.",
    caption = "Kilde: regnskaber_industri_transport_byg_5_25000_ansatte_anonym og egne beregninger."
  ) +
  
  theme_minimal(base_size = 14) +
  theme(
    legend.position = "bottom",
    legend.title    = element_blank(),
    axis.text.x     = element_text(size = 12),
    plot.caption    = element_text(hjust = 0, size = 9)  # venstrestillet kilde
  )


# Balance
  df_balance <- df %>%
  mutate(
    vurdering_gruppe = case_when(
      finansiering %in% c("Gode", "Meget gode") ~ "Positive = Gode / Meget gode",
      finansiering %in% c("Neutrale")          ~ "Neutrale",
      finansiering %in% c("Dårlige", "Meget dårlige") ~ "Negative = Dårlige / Meget dårlige",
      TRUE ~ NA_character_
    )
  ) %>%
  filter(!is.na(vurdering_gruppe))




# 2. Wide -> Long: lav én række pr. år pr. virksomhed
df_long <- df_balance %>%
  pivot_longer(
    cols = c(
      Balance.2016..1.000.kr.,
      Balance.2017..1.000.kr.,
      Balance.2018..1.000.kr.,
      Balance.2019..1.000.kr.,
      Balance.2020..1.000.kr.
    ),
    names_to  = "år",
    values_to = "balance_år"
  ) %>%
  mutate(
    år = as.numeric(substr(år, 9, 12)),
    log_balance = log(balance_år + 1)
  )


# 3. Beregn gennemsnit log(balance) pr. år & gruppe
df_plot <- df_long %>%
  group_by(år, vurdering_gruppe) %>%
  summarise(mean_log_balance = mean(log_balance, na.rm = TRUE),
            .groups = "drop")

# 4. plot
ggplot(df_plot,
       aes(x = factor(år), y = mean_log_balance, fill = vurdering_gruppe)) +
  geom_col(position = position_dodge(width = 0.8), width = 0.7) +
  labs(
    title = "Størrelsen på aktiverne har betydning for lånemulighederne",
    subtitle = "Virksomhedernes balance i forhold til deres vurdering af mængden af kapital",
    x = NULL,
    y = "Log(Balance)",
    fill = NULL,
    caption = "Kilde: regnskaber_industri_transport_byg_5_25000_ansatte_anonym og egne beregninger."
  ) +
  scale_fill_manual(values = c("Negative = Dårlige / Meget dårlige" = "#C4C4C4",
                               "Neutral" = "#4B4A4A",
                               "Positive = Gode / Meget gode" = "#0096DB")) +
  theme_minimal(base_size = 12) +
  theme(
    legend.position = "bottom",
    plot.caption = element_text(hjust = 0)
  )

